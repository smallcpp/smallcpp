#ifndef SMALLCPP_TREE
#define SMALLCPP_TREE

/* TREE(Name, Type) defines a balanced binary tree of Type.
 * Include this header as <tree>. Order is the virtual
 * method compare(Type, Type). Negative means the first
 * value comes first, zero means equal, and positive means
 * the first value comes later, like strcmp. The default
 * calls String.cmp when Type is const char * or String *.
 * Any other type uses <. A subclass overrides compare to
 * change the order. add places a value with compare. An
 * equal value is left in place. insert places a value at
 * the in-order index. A negative index counts from the
 * end. Past the end appends. Before the start prepends.
 * After insert, at(index) is that value. replace writes
 * the value at the index and leaves it there. find
 * returns the in-order index of the first zero result,
 * or -1. root() is the root value. at walks in order and
 * counts a negative index from the end. remove deletes
 * the in-order value at the index. next returns the value
 * at a caller-owned cursor and writes the following
 * index.
 * The cursor starts at 0. A null cursor, or a cursor past
 * either end, throws Exception with message index.
 * Expand the macro in one translation unit.
 *
 *     TREE(IntTree, int)
 *     IntTree *nodes;
 *     nodes = new IntTree();
 *     nodes->add(1);
 */
#include <exceptions>
#include <string>
#include <typeinfo>

#define TREE(Name, Type) \
class Name##Node { \
public: \
    Type value; \
    int height; \
    long size; \
    Name##Node *left; \
    Name##Node *right; \
}; \
class Name { \
    Name##Node *top; \
    long count; \
    int height_of(Name##Node *node) { \
        if (node == nullptr) \
            return 0; \
        return node->height; \
    } \
    int taller(Name##Node *left, Name##Node *right) { \
        int a; \
        int b; \
        a = height_of(left); \
        b = height_of(right); \
        if (a > b) \
            return a; \
        return b; \
    } \
    void measure(Name##Node *node) { \
        long left_n; \
        long right_n; \
        left_n = 0; \
        right_n = 0; \
        if (node->left != nullptr) \
            left_n = node->left->size; \
        if (node->right != nullptr) \
            right_n = node->right->size; \
        node->size = 1 + left_n + right_n; \
        node->height = 1 + taller(node->left, node->right); \
    } \
    int factor(Name##Node *node) { \
        return height_of(node->left) - height_of(node->right); \
    } \
    Name##Node *rotate_left(Name##Node *node) { \
        Name##Node *next; \
        next = node->right; \
        node->right = next->left; \
        next->left = node; \
        measure(node); \
        measure(next); \
        return next; \
    } \
    Name##Node *rotate_right(Name##Node *node) { \
        Name##Node *next; \
        next = node->left; \
        node->left = next->right; \
        next->right = node; \
        measure(node); \
        measure(next); \
        return next; \
    } \
    Name##Node *plant(Name##Node *node, Type value) { \
        int balance; \
        if (node == nullptr) { \
            node = new Name##Node(); \
            node->value = value; \
            node->left = nullptr; \
            node->right = nullptr; \
            node->height = 1; \
            node->size = 1; \
            count = count + 1; \
            return node; \
        } \
        if (compare(value, node->value) < 0) \
            node->left = plant(node->left, value); \
        else if (compare(node->value, value) < 0) \
            node->right = plant(node->right, value); \
        else \
            return node; \
        measure(node); \
        balance = factor(node); \
        if (balance > 1 \
            && compare(value, node->left->value) < 0) \
            return rotate_right(node); \
        if (balance < -1 \
            && compare(node->right->value, value) < 0) \
            return rotate_left(node); \
        if (balance > 1 \
            && compare(node->left->value, value) < 0) { \
            node->left = rotate_left(node->left); \
            return rotate_right(node); \
        } \
        if (balance < -1 \
            && compare(value, node->right->value) < 0) { \
            node->right = rotate_right(node->right); \
            return rotate_left(node); \
        } \
        return node; \
    } \
    Name##Node *settle(Name##Node *node) { \
        int balance; \
        measure(node); \
        balance = factor(node); \
        if (balance > 1 && factor(node->left) >= 0) \
            return rotate_right(node); \
        if (balance > 1 && factor(node->left) < 0) { \
            node->left = rotate_left(node->left); \
            return rotate_right(node); \
        } \
        if (balance < -1 && factor(node->right) <= 0) \
            return rotate_left(node); \
        if (balance < -1 && factor(node->right) > 0) { \
            node->right = rotate_right(node->right); \
            return rotate_left(node); \
        } \
        return node; \
    } \
    long span(Name##Node *node) { \
        if (node == nullptr) \
            return 0; \
        return node->size; \
    } \
    Name##Node *graft(Name##Node *node, long index, \
        Type value) { \
        long left_count; \
        if (node == nullptr) { \
            node = new Name##Node(); \
            node->value = value; \
            node->left = nullptr; \
            node->right = nullptr; \
            node->height = 1; \
            node->size = 1; \
            count = count + 1; \
            return node; \
        } \
        left_count = span(node->left); \
        if (index <= left_count) \
            node->left = graft(node->left, index, value); \
        else \
            node->right = graft(node->right, \
                index - left_count - 1, value); \
        return settle(node); \
    } \
    int write(Name##Node *node, long index, \
        Type value) { \
        long left_count; \
        if (node == nullptr) \
            return 0; \
        left_count = span(node->left); \
        if (index < left_count) \
            return write(node->left, index, value); \
        if (index == left_count) { \
            node->value = value; \
            return 1; \
        } \
        return write(node->right, \
            index - left_count - 1, value); \
    } \
    Name##Node *drop_at(Name##Node *node, long index) { \
        Name##Node *least; \
        long left_count; \
        if (node == nullptr) \
            return nullptr; \
        left_count = span(node->left); \
        if (index < left_count) \
            node->left = drop_at(node->left, index); \
        else if (index > left_count) \
            node->right = drop_at(node->right, \
                index - left_count - 1); \
        else if (node->left == nullptr \
            || node->right == nullptr) { \
            count = count - 1; \
            if (node->left != nullptr) \
                return node->left; \
            return node->right; \
        } else { \
            least = node->right; \
            while (least->left != nullptr) \
                least = least->left; \
            node->value = least->value; \
            node->right = drop_at(node->right, 0); \
        } \
        return settle(node); \
    } \
    int locate(Name##Node *node, Type value, \
        long *seen, long *out) { \
        int found; \
        if (node == nullptr) \
            return 0; \
        found = locate(node->left, value, seen, out); \
        if (found) \
            return 1; \
        if (compare(node->value, value) == 0) { \
            *out = *seen; \
            return 1; \
        } \
        *seen = *seen + 1; \
        return locate(node->right, value, seen, out); \
    } \
    int pick(Name##Node *node, long index, \
        Type *out) { \
        long left_count; \
        if (node == nullptr) \
            return 0; \
        left_count = span(node->left); \
        if (index < left_count) \
            return pick(node->left, index, out); \
        if (index == left_count) { \
            *out = node->value; \
            return 1; \
        } \
        return pick(node->right, \
            index - left_count - 1, out); \
    } \
public: \
    Name() { \
        top = nullptr; \
        count = 0; \
    } \
    virtual long compare(Type left, Type right) { \
        const char *a; \
        const char *b; \
        long i; \
        unsigned char ca; \
        unsigned char cb; \
        String *left_text; \
        String *right_text; \
        if (typeid(Type) == typeid(const char *)) { \
            a = (const char *)left; \
            b = (const char *)right; \
            if (a == nullptr || b == nullptr) \
                throw *new Exception("string"); \
            i = 0; \
            while (a[i] != 0 && a[i] == b[i]) \
                i = i + 1; \
            ca = (unsigned char)a[i]; \
            cb = (unsigned char)b[i]; \
            return (long)ca - (long)cb; \
        } \
        if (typeid(Type) == typeid(String *)) { \
            left_text = (String *)left; \
            right_text = (String *)right; \
            if (left_text == nullptr \
                    || right_text == nullptr) \
                throw *new Exception("string"); \
            a = left_text->c_str(); \
            b = right_text->c_str(); \
            i = 0; \
            while (a[i] != 0 && a[i] == b[i]) \
                i = i + 1; \
            ca = (unsigned char)a[i]; \
            cb = (unsigned char)b[i]; \
            return (long)ca - (long)cb; \
        } \
        if (left < right) \
            return (long)-1; \
        if (right < left) \
            return (long)1; \
        return (long)0; \
    } \
    void add(Type value) { \
        top = plant(top, value); \
    } \
    Type at(long index) { \
        Type found; \
        if (index < 0) \
            index = count + index; \
        if (index < 0 || index >= count) \
            throw *new Exception("index"); \
        pick(top, index, &found); \
        return found; \
    } \
    Type root(void) { \
        if (top == nullptr) \
            throw *new Exception("empty"); \
        return top->value; \
    } \
    long size(void) { \
        return count; \
    } \
    long find(Type value) { \
        long seen; \
        long out; \
        seen = 0; \
        if (locate(top, value, &seen, &out) == 0) \
            return -1; \
        return out; \
    } \
    void replace(long index, Type value) { \
        if (index < 0) \
            index = count + index; \
        if (index < 0 || index >= count) \
            throw *new Exception("index"); \
        write(top, index, value); \
    } \
    void insert(long index, Type value) { \
        if (index < 0) \
            index = count + index; \
        if (index < 0) \
            index = 0; \
        if (index > count) \
            index = count; \
        top = graft(top, index, value); \
    } \
    void remove(long index) { \
        if (index < 0) \
            index = count + index; \
        if (index < 0 || index >= count) \
            throw *new Exception("index"); \
        top = drop_at(top, index); \
    } \
    Type next(long *cursor) { \
        long index; \
        if (cursor == nullptr) \
            throw *new Exception("index"); \
        index = *cursor; \
        if (index < 0) \
            index = count + index; \
        if (index < 0 || index >= count) \
            throw *new Exception("index"); \
        *cursor = index + 1; \
        return at(index); \
    } \
};

#endif
