#ifndef SMALLCPP_TREE
#define SMALLCPP_TREE

/* TREE(Name, Type) defines a balanced binary tree of Type.
 * Include this header as <tree>. Order is the virtual
 * method compare(Type, Type). Negative means the first
 * value comes first, zero means equal, and positive means
 * the first value comes later, like strcmp. The default
 * calls String.cmp when Type is const char * or String *.
 * Any other type uses <. A subclass overrides compare to
 * change the order. add inserts. An equal value is left
 * in place. root() is the root value. at walks in order
 * and counts a negative index from the end. find returns
 * that in-order index for the first zero result, or -1.
 * replace removes the indexed value and inserts the new
 * one so the order stays valid. insert accepts an index
 * the way a sequence does, then places the value with
 * compare, the same as add. remove deletes the in-order
 * value at the index. next returns the value at a
 * caller-owned cursor and writes the following index.
 * The cursor starts at 0. A null cursor, or a cursor past
 * either end, throws Exception with message index.
 * Expand the macro in one translation unit.
 *
 *     TREE(IntTree, int)
 *     IntTree *nodes;
 *     nodes = new IntTree();
 *     nodes->add(1);
 */
#include <exceptions>
#include <string>
#include <typeinfo>

#define TREE(Name, Type) \
class Name##Node { \
public: \
    Type value; \
    int height; \
    Name##Node *left; \
    Name##Node *right; \
}; \
class Name { \
    Name##Node *top; \
    long count; \
    int height_of(Name##Node *node); \
    int taller(Name##Node *left, Name##Node *right); \
    void measure(Name##Node *node); \
    int factor(Name##Node *node); \
    Name##Node *rotate_left(Name##Node *node); \
    Name##Node *rotate_right(Name##Node *node); \
    Name##Node *plant(Name##Node *node, Type value); \
    Name##Node *settle(Name##Node *node); \
    Name##Node *drop(Name##Node *node, Type value); \
    int locate(Name##Node *node, Type value, \
        long *seen, long *out); \
    int pick(Name##Node *node, long *seen, \
        long index, Type *out); \
public: \
    Name(); \
    virtual long compare(Type left, Type right); \
    void add(Type value); \
    Type at(long index); \
    Type root(void); \
    long size(void); \
    long find(Type value); \
    void replace(long index, Type value); \
    void insert(long index, Type value); \
    void remove(long index); \
    Type next(long *cursor); \
}; \
Name::Name() { \
    top = nullptr; \
    count = 0; \
} \
long Name::compare(Type left, Type right) { \
    String *tool; \
    if (typeid(Type) == typeid(const char *)) { \
        tool = new String(); \
        return tool->cmp((const char *)left, \
            (const char *)right); \
    } \
    if (typeid(Type) == typeid(String *)) { \
        tool = new String(); \
        return tool->cmp((String *)left, \
            (String *)right); \
    } \
    if (left < right) \
        return (long)-1; \
    if (right < left) \
        return (long)1; \
    return (long)0; \
} \
int Name::height_of(Name##Node *node) { \
    if (node == nullptr) \
        return 0; \
    return node->height; \
} \
int Name::taller(Name##Node *left, Name##Node *right) { \
    int a; \
    int b; \
    a = height_of(left); \
    b = height_of(right); \
    if (a > b) \
        return a; \
    return b; \
} \
void Name::measure(Name##Node *node) { \
    node->height = 1 + taller(node->left, node->right); \
} \
int Name::factor(Name##Node *node) { \
    return height_of(node->left) - height_of(node->right); \
} \
Name##Node *Name::rotate_left(Name##Node *node) { \
    Name##Node *next; \
    next = node->right; \
    node->right = next->left; \
    next->left = node; \
    measure(node); \
    measure(next); \
    return next; \
} \
Name##Node *Name::rotate_right(Name##Node *node) { \
    Name##Node *next; \
    next = node->left; \
    node->left = next->right; \
    next->right = node; \
    measure(node); \
    measure(next); \
    return next; \
} \
Name##Node *Name::plant(Name##Node *node, Type value) { \
    int balance; \
    if (node == nullptr) { \
        node = new Name##Node(); \
        node->value = value; \
        node->left = nullptr; \
        node->right = nullptr; \
        node->height = 1; \
        count = count + 1; \
        return node; \
    } \
    if (compare(value, node->value) < 0) \
        node->left = plant(node->left, value); \
    else if (compare(node->value, value) < 0) \
        node->right = plant(node->right, value); \
    else \
        return node; \
    measure(node); \
    balance = factor(node); \
    if (balance > 1 \
        && compare(value, node->left->value) < 0) \
        return rotate_right(node); \
    if (balance < -1 \
        && compare(node->right->value, value) < 0) \
        return rotate_left(node); \
    if (balance > 1 \
        && compare(node->left->value, value) < 0) { \
        node->left = rotate_left(node->left); \
        return rotate_right(node); \
    } \
    if (balance < -1 \
        && compare(value, node->right->value) < 0) { \
        node->right = rotate_right(node->right); \
        return rotate_left(node); \
    } \
    return node; \
} \
Name##Node *Name::settle(Name##Node *node) { \
    int balance; \
    measure(node); \
    balance = factor(node); \
    if (balance > 1 && factor(node->left) >= 0) \
        return rotate_right(node); \
    if (balance > 1 && factor(node->left) < 0) { \
        node->left = rotate_left(node->left); \
        return rotate_right(node); \
    } \
    if (balance < -1 && factor(node->right) <= 0) \
        return rotate_left(node); \
    if (balance < -1 && factor(node->right) > 0) { \
        node->right = rotate_right(node->right); \
        return rotate_left(node); \
    } \
    return node; \
} \
Name##Node *Name::drop(Name##Node *node, Type value) { \
    Name##Node *least; \
    if (node == nullptr) \
        return nullptr; \
    if (compare(value, node->value) < 0) \
        node->left = drop(node->left, value); \
    else if (compare(node->value, value) < 0) \
        node->right = drop(node->right, value); \
    else if (node->left == nullptr || node->right == nullptr) { \
        count = count - 1; \
        if (node->left != nullptr) \
            return node->left; \
        return node->right; \
    } else { \
        least = node->right; \
        while (least->left != nullptr) \
            least = least->left; \
        node->value = least->value; \
        node->right = drop(node->right, least->value); \
    } \
    return settle(node); \
} \
int Name::locate(Name##Node *node, Type value, \
    long *seen, long *out) { \
    int found; \
    if (node == nullptr) \
        return 0; \
    found = locate(node->left, value, seen, out); \
    if (found) \
        return 1; \
    if (compare(node->value, value) == 0) { \
        *out = *seen; \
        return 1; \
    } \
    *seen = *seen + 1; \
    return locate(node->right, value, seen, out); \
} \
int Name::pick(Name##Node *node, long *seen, \
    long index, Type *out) { \
    int found; \
    if (node == nullptr) \
        return 0; \
    found = pick(node->left, seen, index, out); \
    if (found) \
        return 1; \
    if (*seen == index) { \
        *out = node->value; \
        return 1; \
    } \
    *seen = *seen + 1; \
    return pick(node->right, seen, index, out); \
} \
void Name::add(Type value) { \
    top = plant(top, value); \
} \
Type Name::at(long index) { \
    Type found; \
    long seen; \
    if (index < 0) \
        index = count + index; \
    if (index < 0 || index >= count) \
        throw *new Exception("index"); \
    seen = 0; \
    pick(top, &seen, index, &found); \
    return found; \
} \
Type Name::root(void) { \
    if (top == nullptr) \
        throw *new Exception("empty"); \
    return top->value; \
} \
long Name::size(void) { \
    return count; \
} \
long Name::find(Type value) { \
    long seen; \
    long out; \
    seen = 0; \
    if (locate(top, value, &seen, &out) == 0) \
        return -1; \
    return out; \
} \
void Name::replace(long index, Type value) { \
    Type old; \
    if (index < 0) \
        index = count + index; \
    if (index < 0 || index >= count) \
        throw *new Exception("index"); \
    old = at(index); \
    if (compare(old, value) == 0) \
        return; \
    top = drop(top, old); \
    add(value); \
} \
void Name::insert(long index, Type value) { \
    /* Sequence bounds. Tree order chooses the place. */ \
    if (index < 0) \
        index = count + index; \
    if (index < 0) \
        index = 0; \
    if (index > count) \
        index = count; \
    add(value); \
} \
void Name::remove(long index) { \
    Type value; \
    if (index < 0) \
        index = count + index; \
    if (index < 0 || index >= count) \
        throw *new Exception("index"); \
    value = at(index); \
    top = drop(top, value); \
} \
Type Name::next(long *cursor) { \
    long index; \
    if (cursor == nullptr) \
        throw *new Exception("index"); \
    index = *cursor; \
    if (index < 0) \
        index = count + index; \
    if (index < 0 || index >= count) \
        throw *new Exception("index"); \
    *cursor = index + 1; \
    return at(index); \
}

#endif
