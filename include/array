#ifndef SMALLCPP_ARRAY
#define SMALLCPP_ARRAY

/* Growable array of bytes. Include this header as <array>.
 * stride is the element size. count is the number of elements
 * in use. room is how many elements bytes can hold. The first
 * allocation holds 4 elements. Vector and Hash are built on it.
 * A program allocates an Array with new. */
class Array {
public:
    char *bytes;
    long count;
    long room;
    long stride;
    Array(long element);
    void reserve(long need);
    char *address(long index);
    long size(void);
};

Array::Array(long element) {
    stride = element;
    if (stride < 1)
        stride = 1;
    count = 0;
    room = 4;
    bytes = new char[room * stride];
}

void Array::reserve(long need) {
    char *grown;
    long next;
    long used;
    long i;

    if (need <= room)
        return;
    next = room;
    while (next < need)
        next = next * 2;
    grown = new char[next * stride];
    used = count * stride;
    i = 0;
    while (i < used) {
        grown[i] = bytes[i];
        i = i + 1;
    }
    bytes = grown;
    room = next;
}

char *Array::address(long index) {
    return bytes + index * stride;
}

long Array::size(void) {
    return count;
}

#endif
