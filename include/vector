#ifndef SMALLCPP_VECTOR
#define SMALLCPP_VECTOR

/* VECTOR(Name, Type) defines a growable array of Type.
 * Include this header as <vector>. Name is the class.
 * Type is copied by assignment. The class uses Array.
 * at counts a negative index from the end.
 * Expand the macro in one translation unit.
 *
 *     VECTOR(IntVec, int)
 *     IntVec *values;
 *     values = new IntVec();
 *     values->add(10);
 */
#include <array>
#include <exceptions>

#define VECTOR(Name, Type) \
class Name : public Array { \
public: \
    Name(); \
    void add(Type value); \
    Type at(long index); \
}; \
Name::Name() : Array((long)sizeof(Type)) { \
} \
void Name::add(Type value) { \
    Type *place; \
    reserve(count + 1); \
    place = (Type *)(bytes + count * stride); \
    *place = value; \
    count = count + 1; \
} \
Type Name::at(long index) { \
    Type *place; \
    if (index < 0) \
        index = count + index; \
    if (index < 0 || index >= count) \
        throw *new Exception("index"); \
    place = (Type *)address(index); \
    return *place; \
}

#endif
