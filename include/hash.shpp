#ifndef SMALLCPP_HASH
#define SMALLCPP_HASH

/* HASH(Name, Key, Value) defines an open hash table.
 * Include this header as <hash>. The slots live in an
 * Array. Equality is the virtual method
 * compare(Key, Key). Zero means equal. The default
 * calls String.cmp when Key is const char * or
 * String *. Any other type uses ==. A subclass
 * overrides compare to change equality. There is no
 * hash callback. const char * and String * are hashed
 * by their characters. Any other key is hashed as
 * bytes. put, find, replace, and remove call compare
 * on the filled slots, so an override does not have
 * to agree with that hash. put inserts or replaces.
 * replace does the same. remove deletes a key and
 * leaves a missing key as it was. find writes *out
 * and returns 1, or returns 0. next walks filled
 * slots from a caller-owned cursor. The cursor starts
 * at 0. next returns 1 and writes the key and value,
 * or 0 when the walk is finished. A null cursor, key,
 * or value pointer throws Exception with message
 * hash. Expand the macro in one translation unit.
 *
 *     HASH(IntMap, int, int)
 *     IntMap *map;
 *     map = new IntMap();
 *     map->put(1, 10);
 */
#include <array>
#include <exceptions>
#include <string>
#include <typeinfo>

#define HASH(Name, Key, Value) \
enum Name##State { \
    Name##EMPTY = 0, \
    Name##FILLED = 1 \
}; \
class Name##Slot { \
public: \
    Key key; \
    Value value; \
    int state; \
}; \
class Name : public Array { \
    long bucket(Key *key) { \
        unsigned char *raw; \
        unsigned long code; \
        long i; \
        String *text; \
        if (typeid(Key) == typeid(const char *)) \
            return text_code(*(const char **)key); \
        if (typeid(Key) == typeid(String *)) { \
            text = *(String **)key; \
            if (text == nullptr) \
                return text_code(""); \
            return text_code(text->c_str()); \
        } \
        raw = (unsigned char *)key; \
        code = 0; \
        i = 0; \
        while (i < (long)sizeof(Key)) { \
            code = code * 131 + raw[i]; \
            i = i + 1; \
        } \
        if (room < 1) \
            return (long)0; \
        return (long)(code % (unsigned long)room); \
    } \
    long text_code(const char *text) { \
        unsigned long code; \
        unsigned char byte; \
        long i; \
        if (text == nullptr) \
            text = ""; \
        code = 0; \
        i = 0; \
        while (text[i] != 0) { \
            byte = (unsigned char)text[i]; \
            code = code * 131 + byte; \
            i = i + 1; \
        } \
        if (room < 1) \
            return (long)0; \
        return (long)(code % (unsigned long)room); \
    } \
    void place(Key key, Value value) { \
        Name##Slot *table; \
        long slot; \
        long n; \
        table = (Name##Slot *)bytes; \
        slot = 0; \
        while (slot < room) { \
            if (table[slot].state == Name##FILLED \
                && compare(table[slot].key, key) == 0) { \
                table[slot].value = value; \
                return; \
            } \
            slot = slot + 1; \
        } \
        slot = bucket(&key); \
        n = 0; \
        while (n < room) { \
            if (table[slot].state == Name##EMPTY) { \
                table[slot].key = key; \
                table[slot].value = value; \
                table[slot].state = Name##FILLED; \
                count = count + 1; \
                return; \
            } \
            slot = slot + 1; \
            if (slot == room) \
                slot = 0; \
            n = n + 1; \
        } \
        throw *new Exception("hash"); \
    } \
    void rehash(long next) { \
        Name##Slot *old; \
        long old_room; \
        long i; \
        old = (Name##Slot *)bytes; \
        old_room = room; \
        room = next; \
        count = 0; \
        bytes = new char[room * stride]; \
        zero(); \
        i = 0; \
        while (i < old_room) { \
            if (old[i].state == Name##FILLED) \
                place(old[i].key, old[i].value); \
            i = i + 1; \
        } \
    } \
    void zero(void) { \
        long i; \
        long n; \
        n = room * stride; \
        i = 0; \
        while (i < n) { \
            bytes[i] = 0; \
            i = i + 1; \
        } \
    } \
public: \
    Name() : Array((long)sizeof(Name##Slot)) { \
        zero(); \
    } \
    virtual long compare(Key left, Key right) { \
        const char *a; \
        const char *b; \
        long i; \
        unsigned char ca; \
        unsigned char cb; \
        String *left_text; \
        String *right_text; \
        if (typeid(Key) == typeid(const char *)) { \
            a = (const char *)left; \
            b = (const char *)right; \
            if (a == nullptr || b == nullptr) \
                throw *new Exception("string"); \
            i = 0; \
            while (a[i] != 0 && a[i] == b[i]) \
                i = i + 1; \
            ca = (unsigned char)a[i]; \
            cb = (unsigned char)b[i]; \
            return (long)ca - (long)cb; \
        } \
        if (typeid(Key) == typeid(String *)) { \
            left_text = (String *)left; \
            right_text = (String *)right; \
            if (left_text == nullptr \
                    || right_text == nullptr) \
                throw *new Exception("string"); \
            a = left_text->c_str(); \
            b = right_text->c_str(); \
            i = 0; \
            while (a[i] != 0 && a[i] == b[i]) \
                i = i + 1; \
            ca = (unsigned char)a[i]; \
            cb = (unsigned char)b[i]; \
            return (long)ca - (long)cb; \
        } \
        if (left == right) \
            return (long)0; \
        return (long)1; \
    } \
    void put(Key key, Value value) { \
        if ((count + 1) * 2 > room) \
            rehash(room * 2); \
        place(key, value); \
    } \
    int find(Key key, Value *out) { \
        Name##Slot *table; \
        long slot; \
        if (out == nullptr) \
            throw *new Exception("hash"); \
        table = (Name##Slot *)bytes; \
        slot = 0; \
        while (slot < room) { \
            if (table[slot].state == Name##FILLED \
                && compare(table[slot].key, key) == 0) { \
                *out = table[slot].value; \
                return 1; \
            } \
            slot = slot + 1; \
        } \
        return 0; \
    } \
    void replace(Key key, Value value) { \
        put(key, value); \
    } \
    void remove(Key key) { \
        Name##Slot *table; \
        long slot; \
        table = (Name##Slot *)bytes; \
        slot = 0; \
        while (slot < room) { \
            if (table[slot].state == Name##FILLED \
                && compare(table[slot].key, key) == 0) { \
                table[slot].state = Name##EMPTY; \
                count = count - 1; \
                return; \
            } \
            slot = slot + 1; \
        } \
    } \
    int next(long *cursor, Key *key, Value *value) { \
        Name##Slot *table; \
        long i; \
        if (cursor == nullptr || key == nullptr || value == nullptr) \
            throw *new Exception("hash"); \
        if (*cursor < 0) \
            throw *new Exception("hash"); \
        table = (Name##Slot *)bytes; \
        i = *cursor; \
        while (i < room) { \
            if (table[i].state == Name##FILLED) { \
                *key = table[i].key; \
                *value = table[i].value; \
                *cursor = i + 1; \
                return 1; \
            } \
            i = i + 1; \
        } \
        *cursor = i; \
        return 0; \
    } \
};

#endif
