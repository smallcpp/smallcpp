#ifndef SMALLCPP_SOCKET
#define SMALLCPP_SOCKET

/* IPv4 TCP. Include this header as <socket>. Link with
 * libc. A nonzero getaddrinfo result is not errno.
 * gai_strerror describes it. send and recv move bytes.
 * close, from <unistd>, releases the descriptor. */

#ifndef SMALLCPP_SOCKLEN_T
#define SMALLCPP_SOCKLEN_T
typedef unsigned socklen_t;
#endif

struct sockaddr {
    unsigned short sa_family;
    char sa_data[14];
};

struct sockaddr_in {
    unsigned short sin_family;
    unsigned short sin_port;
    unsigned int sin_addr;
    char sin_zero[8];
};

struct addrinfo {
    int ai_flags;
    int ai_family;
    int ai_socktype;
    int ai_protocol;
    unsigned ai_addrlen;
    struct sockaddr *ai_addr;
    char *ai_canonname;
    struct addrinfo *ai_next;
};

struct timeval {
    long tv_sec;
    long tv_usec;
};

#define AF_INET 2
#define SOCK_STREAM 1
#define IPPROTO_TCP 6
#define SO_RCVTIMEO 20

extern int socket(int domain, int type, int protocol);
extern int connect(int fd, const struct sockaddr *addr,
    socklen_t len);
extern int bind(int fd, const struct sockaddr *addr,
    socklen_t len);
extern int listen(int fd, int backlog);
extern int accept(int fd, struct sockaddr *addr,
    socklen_t *len);
extern long send(int fd, const void *buf, unsigned long len,
    int flags);
extern long recv(int fd, void *buf, unsigned long len,
    int flags);
extern int setsockopt(int fd, int level, int optname,
    const void *value, socklen_t len);
extern int getaddrinfo(const char *host, const char *service,
    const struct addrinfo *hints, struct addrinfo **out);
extern void freeaddrinfo(struct addrinfo *out);
extern const char *gai_strerror(int err);
extern unsigned short htons(unsigned short value);
extern unsigned int htonl(unsigned int value);
extern int inet_pton(int family, const char *text, void *dst);

#endif
