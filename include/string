#ifndef SMALLCPP_STRING
#define SMALLCPP_STRING

/* Growable array of char. Include this header as <string>.
 * size() is the character count. capacity() is the allocated
 * bytes, including the trailing null. add copies characters.
 * at, find, rfind, insert, and truncate count a negative
 * index from the end. find returns -1 when the text is
 * missing or the start is past the end. rfind walks toward
 * the front. Its index is the last place a match may begin.
 * An rfind index past the end searches the whole string.
 * insert appends past the end and prepends before the start.
 * truncate clamps each bound and removes nothing when the
 * first bound is past the second. cmp returns what strcmp
 * would return. A null pointer is not a string. An empty
 * string is valid. A program allocates a String with new. */
#include <array>
#include <exceptions>

class String : public Array {
public:
    String();
    String(const String *other);
    void add(char value);
    void add(const char *text);
    long capacity(void);
    char at(long index);
    const char *chars(void) const;
    const char *c_str(void) const;
    int strip(void);
    int strip(char value);
    long find(char value);
    long find(const char *text);
    long find(const String *text);
    long find(long index, char value);
    long find(long index, const char *text);
    long find(long index, const String *text);
    long rfind(char value);
    long rfind(const char *text);
    long rfind(const String *text);
    long rfind(long index, char value);
    long rfind(long index, const char *text);
    long rfind(long index, const String *text);
    long cmp(const String *left, const String *right);
    long cmp(const char *left, const char *right);
    long cmp(const char *left, const String *right);
    long cmp(const String *left, const char *right);
    void append(char value);
    void append(const char *text);
    void append(const String *text);
    void prepend(char value);
    void prepend(const char *text);
    void prepend(const String *text);
    void insert(long index, char value);
    void insert(long index, const char *text);
    void insert(long index, const String *text);
    void truncate(long from, long to);
    void replace(char needle, char value);
    void replace(char needle, const char *text);
    void replace(char needle, const String *text);
    void replace(const char *needle, char value);
    void replace(const char *needle, const char *text);
    void replace(const char *needle, const String *text);
    void replace(const String *needle, char value);
    void replace(const String *needle, const char *text);
    void replace(const String *needle, const String *text);
private:
    int blank(char value);
    long text_length(const char *text);
    void splice(long at, long n, const char *text);
};

String::String() : Array(1) {
    bytes[0] = 0;
}

String::String(const String *other) : Array(1) {
    if (other == nullptr)
        throw *new Exception("string");
    bytes[0] = 0;
    add(other->chars());
}

void String::add(char value) {
    reserve(count + 2);
    bytes[count] = value;
    count = count + 1;
    bytes[count] = 0;
}

void String::add(const char *text) {
    long i;

    if (text == nullptr)
        throw *new Exception("string");
    i = 0;
    while (text[i] != 0) {
        add(text[i]);
        i = i + 1;
    }
}

long String::capacity(void) {
    return room;
}

char String::at(long index) {
    if (index < 0)
        index = count + index;
    if (index < 0 || index >= count)
        throw *new Exception("index");
    return bytes[index];
}

const char *String::chars(void) const {
    return bytes;
}

const char *String::c_str(void) const {
    return bytes;
}

int String::blank(char value) {
    if (value == ' ' || value == '\n' || value == '\r')
        return 1;
    return 0;
}

int String::strip(void) {
    long begin;
    long end;
    long kept;
    long i;
    int removed;

    begin = 0;
    while (begin < count && blank(bytes[begin]) == 1)
        begin = begin + 1;
    end = count;
    while (end > begin && blank(bytes[end - 1]) == 1)
        end = end - 1;
    removed = (int)(begin + count - end);
    if (removed == 0)
        return 0;
    kept = end - begin;
    i = 0;
    while (i < kept) {
        bytes[i] = bytes[begin + i];
        i = i + 1;
    }
    count = kept;
    bytes[count] = 0;
    return removed;
}

int String::strip(char value) {
    long read;
    long write;
    int removed;

    read = 0;
    write = 0;
    removed = 0;
    while (read < count) {
        if (bytes[read] == value)
            removed = removed + 1;
        else {
            bytes[write] = bytes[read];
            write = write + 1;
        }
        read = read + 1;
    }
    count = write;
    bytes[count] = 0;
    return removed;
}

long String::text_length(const char *text) {
    long n;

    n = 0;
    while (text[n] != 0)
        n = n + 1;
    return n;
}

void String::splice(long at, long n, const char *text) {
    long m;
    long i;
    long tail;
    long next;
    long after;
    char *fresh;

    m = text_length(text);
    if (n == 0 && m == 0)
        return;
    next = room;
    while (next < count - n + m + 1)
        next = next * 2;
    fresh = new char[next];
    after = at + n;
    tail = count - after;
    i = 0;
    while (i < at) {
        fresh[i] = bytes[i];
        i = i + 1;
    }
    i = 0;
    while (i < m) {
        fresh[at + i] = text[i];
        i = i + 1;
    }
    i = 0;
    while (i < tail) {
        fresh[at + m + i] = bytes[after + i];
        i = i + 1;
    }
    count = at + m + tail;
    fresh[count] = 0;
    bytes = fresh;
    room = next;
}

long String::find(long index, char value) {
    if (index < 0)
        index = count + index;
    if (index < 0 || index >= count)
        return -1;
    while (index < count) {
        if (bytes[index] == value)
            return index;
        index = index + 1;
    }
    return -1;
}

long String::find(char value) {
    return find((long)0, value);
}

long String::find(long index, const char *text) {
    long n;
    long i;
    long j;

    if (text == nullptr)
        throw *new Exception("string");
    if (index < 0)
        index = count + index;
    if (index < 0 || index > count)
        return -1;
    n = text_length(text);
    if (n == 0)
        return index;
    if (index >= count)
        return -1;
    i = index;
    while (i + n <= count) {
        j = 0;
        while (j < n && bytes[i + j] == text[j])
            j = j + 1;
        if (j == n)
            return i;
        i = i + 1;
    }
    return -1;
}

long String::find(const char *text) {
    if (text == nullptr)
        throw *new Exception("string");
    return find((long)0, text);
}

long String::find(long index, const String *text) {
    if (text == nullptr)
        throw *new Exception("string");
    return find(index, text->chars());
}

long String::find(const String *text) {
    if (text == nullptr)
        throw *new Exception("string");
    return find(text->chars());
}

long String::rfind(long index, char value) {
    if (index < 0)
        index = count + index;
    if (index < 0 || count == 0)
        return -1;
    if (index >= count)
        index = count - 1;
    while (index >= 0) {
        if (bytes[index] == value)
            return index;
        index = index - 1;
    }
    return -1;
}

long String::rfind(char value) {
    if (count == 0)
        return -1;
    return rfind(count - 1, value);
}

long String::rfind(long index, const char *text) {
    long n;
    long i;
    long j;
    long last;

    if (text == nullptr)
        throw *new Exception("string");
    if (index < 0)
        index = count + index;
    n = text_length(text);
    if (n == 0) {
        if (index < 0)
            return -1;
        if (index > count)
            return count;
        return index;
    }
    if (index < 0 || count < n)
        return -1;
    last = count - n;
    if (index < last)
        last = index;
    i = last;
    while (i >= 0) {
        j = 0;
        while (j < n && bytes[i + j] == text[j])
            j = j + 1;
        if (j == n)
            return i;
        if (i == 0)
            break;
        i = i - 1;
    }
    return -1;
}

long String::rfind(const char *text) {
    if (text == nullptr)
        throw *new Exception("string");
    if (text[0] == 0)
        return count;
    if (count == 0)
        return -1;
    return rfind(count - 1, text);
}

long String::rfind(long index, const String *text) {
    if (text == nullptr)
        throw *new Exception("string");
    return rfind(index, text->chars());
}

long String::rfind(const String *text) {
    if (text == nullptr)
        throw *new Exception("string");
    return rfind(text->chars());
}

long String::cmp(const char *left, const char *right) {
    long i;
    unsigned char a;
    unsigned char b;

    if (left == nullptr || right == nullptr)
        throw *new Exception("string");
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    a = (unsigned char)left[i];
    b = (unsigned char)right[i];
    return (long)a - (long)b;
}

long String::cmp(const String *left, const String *right) {
    if (left == nullptr || right == nullptr)
        throw *new Exception("string");
    return cmp(left->chars(), right->chars());
}

long String::cmp(const char *left, const String *right) {
    if (left == nullptr || right == nullptr)
        throw *new Exception("string");
    return cmp(left, right->chars());
}

long String::cmp(const String *left, const char *right) {
    if (left == nullptr || right == nullptr)
        throw *new Exception("string");
    return cmp(left->chars(), right);
}

void String::append(char value) {
    add(value);
}

void String::append(const char *text) {
    if (text == nullptr)
        throw *new Exception("string");
    insert(count, text);
}

void String::append(const String *text) {
    if (text == nullptr)
        throw *new Exception("string");
    append(text->chars());
}

void String::prepend(char value) {
    insert((long)0, value);
}

void String::prepend(const char *text) {
    if (text == nullptr)
        throw *new Exception("string");
    insert((long)0, text);
}

void String::prepend(const String *text) {
    if (text == nullptr)
        throw *new Exception("string");
    prepend(text->chars());
}

void String::insert(long index, const char *text) {
    if (text == nullptr)
        throw *new Exception("string");
    if (index < 0)
        index = count + index;
    if (index < 0)
        index = 0;
    if (index > count)
        index = count;
    splice(index, (long)0, text);
}

void String::insert(long index, char value) {
    char text[2];

    text[0] = value;
    text[1] = 0;
    insert(index, text);
}

void String::insert(long index, const String *text) {
    if (text == nullptr)
        throw *new Exception("string");
    insert(index, text->chars());
}

void String::truncate(long from, long to) {
    long i;
    long tail;

    if (from < 0)
        from = count + from;
    if (to < 0)
        to = count + to;
    if (from < 0)
        from = 0;
    if (to < 0)
        to = 0;
    if (from > count)
        from = count;
    if (to > count)
        to = count;
    if (from >= to)
        return;
    tail = count - to;
    i = 0;
    while (i < tail) {
        bytes[from + i] = bytes[to + i];
        i = i + 1;
    }
    count = from + tail;
    bytes[count] = 0;
}

void String::replace(char needle, char value) {
    long at;

    at = find(needle);
    if (at < 0)
        return;
    bytes[at] = value;
}

void String::replace(char needle, const char *text) {
    long at;

    if (text == nullptr)
        throw *new Exception("string");
    at = find(needle);
    if (at < 0)
        return;
    splice(at, (long)1, text);
}

void String::replace(char needle, const String *text) {
    if (text == nullptr)
        throw *new Exception("string");
    replace(needle, text->chars());
}

void String::replace(const char *needle, char value) {
    char text[2];
    long at;
    long n;

    if (needle == nullptr)
        throw *new Exception("string");
    at = find(needle);
    if (at < 0)
        return;
    n = text_length(needle);
    text[0] = value;
    text[1] = 0;
    splice(at, n, text);
}

void String::replace(const char *needle, const char *text) {
    long at;
    long n;

    if (needle == nullptr || text == nullptr)
        throw *new Exception("string");
    at = find(needle);
    if (at < 0)
        return;
    n = text_length(needle);
    splice(at, n, text);
}

void String::replace(const char *needle, const String *text) {
    if (needle == nullptr || text == nullptr)
        throw *new Exception("string");
    replace(needle, text->chars());
}

void String::replace(const String *needle, char value) {
    if (needle == nullptr)
        throw *new Exception("string");
    replace(needle->chars(), value);
}

void String::replace(const String *needle, const char *text) {
    if (needle == nullptr || text == nullptr)
        throw *new Exception("string");
    replace(needle->chars(), text);
}

void String::replace(const String *needle, const String *text) {
    if (needle == nullptr || text == nullptr)
        throw *new Exception("string");
    replace(needle->chars(), text->chars());
}

#endif
