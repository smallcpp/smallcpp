#ifndef SMALLCPP_LIST
#define SMALLCPP_LIST

/* LIST(Name, Type) defines a doubly linked list of Type.
 * Include this header as <list>. add appends. at walks
 * from the head and counts a negative index from the end.
 * from_end walks from the tail with a non-negative index.
 * replace, remove, and next use that same negative index.
 * insert appends past the end and prepends before the
 * start. find returns the first == match, or -1.
 * next returns the value at a caller-owned cursor and
 * writes the following index. The cursor starts at 0.
 * A null cursor, or a cursor past either end, throws
 * Exception with message index.
 * Expand the macro in one translation unit.
 *
 *     LIST(IntList, int)
 *     IntList *items;
 *     items = new IntList();
 *     items->add(1);
 */
#include <exceptions>

#define LIST(Name, Type) \
class Name##Node { \
public: \
    Type value; \
    Name##Node *prev; \
    Name##Node *next; \
}; \
class Name { \
    Name##Node *cached; \
    long cached_at; \
    void forget(void); \
    Name##Node *node_at(long index); \
public: \
    Name##Node *head; \
    Name##Node *tail; \
    long count; \
    Name(); \
    void add(Type value); \
    Type at(long index); \
    Type from_end(long index); \
    long size(void); \
    long find(Type value); \
    void replace(long index, Type value); \
    void insert(long index, Type value); \
    void remove(long index); \
    Type next(long *cursor); \
}; \
Name::Name() { \
    head = nullptr; \
    tail = nullptr; \
    cached = nullptr; \
    cached_at = 0; \
    count = 0; \
} \
void Name::forget(void) { \
    cached = nullptr; \
} \
Name##Node *Name::node_at(long index) { \
    Name##Node *node; \
    long i; \
    long from_head; \
    long from_tail; \
    long from_cache; \
    int backward; \
    from_head = index; \
    from_tail = (count - 1) - index; \
    from_cache = count; \
    if (cached != nullptr) { \
        if (index >= cached_at) \
            from_cache = index - cached_at; \
        else \
            from_cache = cached_at - index; \
    } \
    if (cached != nullptr && from_cache <= from_head \
            && from_cache <= from_tail) { \
        node = cached; \
        i = cached_at; \
        backward = index < cached_at; \
    } else if (from_tail < from_head) { \
        node = tail; \
        i = count - 1; \
        backward = 1; \
    } else { \
        node = head; \
        i = 0; \
        backward = 0; \
    } \
    if (backward) { \
        while (i > index) { \
            node = node->prev; \
            i = i - 1; \
        } \
    } else { \
        while (i < index) { \
            node = node->next; \
            i = i + 1; \
        } \
    } \
    cached = node; \
    cached_at = index; \
    return node; \
} \
void Name::add(Type value) { \
    Name##Node *node; \
    node = new Name##Node(); \
    node->value = value; \
    node->next = nullptr; \
    node->prev = tail; \
    if (tail == nullptr) \
        head = node; \
    else \
        tail->next = node; \
    tail = node; \
    count = count + 1; \
    forget(); \
} \
Type Name::at(long index) { \
    Name##Node *node; \
    if (index < 0) \
        index = count + index; \
    if (index < 0 || index >= count) \
        throw *new Exception("index"); \
    node = node_at(index); \
    return node->value; \
} \
Type Name::from_end(long index) { \
    Name##Node *node; \
    long i; \
    if (index < 0 || index >= count) \
        throw *new Exception("index"); \
    node = tail; \
    i = 0; \
    while (i < index) { \
        node = node->prev; \
        i = i + 1; \
    } \
    return node->value; \
} \
long Name::size(void) { \
    return count; \
} \
long Name::find(Type value) { \
    Name##Node *node; \
    long i; \
    node = head; \
    i = 0; \
    while (node != nullptr) { \
        if (node->value == value) \
            return i; \
        node = node->next; \
        i = i + 1; \
    } \
    return -1; \
} \
void Name::replace(long index, Type value) { \
    Name##Node *node; \
    if (index < 0) \
        index = count + index; \
    if (index < 0 || index >= count) \
        throw *new Exception("index"); \
    node = node_at(index); \
    node->value = value; \
} \
void Name::insert(long index, Type value) { \
    Name##Node *node; \
    Name##Node *at; \
    if (index < 0) \
        index = count + index; \
    if (index < 0) \
        index = 0; \
    if (index > count) \
        index = count; \
    if (index == count) { \
        add(value); \
        return; \
    } \
    node = new Name##Node(); \
    node->value = value; \
    if (index == 0) { \
        node->prev = nullptr; \
        node->next = head; \
        head->prev = node; \
        head = node; \
        count = count + 1; \
        forget(); \
        return; \
    } \
    at = node_at(index); \
    node->next = at; \
    node->prev = at->prev; \
    at->prev->next = node; \
    at->prev = node; \
    count = count + 1; \
    forget(); \
} \
void Name::remove(long index) { \
    Name##Node *node; \
    if (index < 0) \
        index = count + index; \
    if (index < 0 || index >= count) \
        throw *new Exception("index"); \
    node = node_at(index); \
    if (node->prev == nullptr) \
        head = node->next; \
    else \
        node->prev->next = node->next; \
    if (node->next == nullptr) \
        tail = node->prev; \
    else \
        node->next->prev = node->prev; \
    count = count - 1; \
    forget(); \
} \
Type Name::next(long *cursor) { \
    long index; \
    if (cursor == nullptr) \
        throw *new Exception("index"); \
    index = *cursor; \
    if (index < 0) \
        index = count + index; \
    if (index < 0 || index >= count) \
        throw *new Exception("index"); \
    *cursor = index + 1; \
    return at(index); \
}

#endif
