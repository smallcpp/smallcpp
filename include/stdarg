#ifndef SMALLCPP_STDARG
#define SMALLCPP_STDARG

/* Variable arguments. Include this header as <stdarg>.
 * va_start names the last fixed parameter. va_arg
 * returns the next argument as the named type.
 * va_copy copies a list. The two lists then walk
 * independently. va_end finishes a list and is safe
 * on a copy. The record matches the host va_list. */

struct __va_list_tag {
    unsigned gp_offset;
    unsigned fp_offset;
    void *overflow_arg_area;
    void *reg_save_area;
};

typedef struct __va_list_tag va_list;

#define va_start(ap, param) __builtin_va_start(&(ap))
#define va_arg(ap, type) (*((type *)__builtin_va_arg(&(ap), (type *)0)))
#define va_end(ap) __builtin_va_end(&(ap))
#define va_copy(dest, src) __builtin_va_copy(&(dest), &(src))

#endif
