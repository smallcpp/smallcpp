#ifndef SMALLCPP_GTK
#define SMALLCPP_GTK

/* GTK 4 widgets. Include this header as <gtk>.
 * The classes are in namespace Gtk. This header
 * does not name the C library. The implementation
 * calls that library with extern. Link with
 * -l smallcpp_gtk -l gtk-4 -l gio-2.0
 * -l gobject-2.0 -l glib-2.0 -l pango-1.0
 * -l pangocairo-1.0 -l cairo.
 * GTK_HORIZONTAL is 0 and GTK_VERTICAL is 1.
 * GTK_POLICY_ALWAYS through GTK_POLICY_EXTERNAL
 * are 0 through 3. A null string throws Exception
 * with message null. Invalid UTF-8 throws utf8.
 * Use after dispose throws disposed. A call from
 * a thread other than the GUI thread throws
 * thread, except Application::post. dispose is
 * explicit. The destructor does not dispose.
 * TextIter stores a line and a character offset.
 * It is not a live iterator. Copy those two
 * numbers to keep a position. A TextMark stays
 * with the text. Fields below the methods are
 * implementation slots. */

namespace Gtk {

enum {
    GTK_HORIZONTAL,
    GTK_VERTICAL
};

enum {
    GTK_POLICY_ALWAYS,
    GTK_POLICY_AUTOMATIC,
    GTK_POLICY_NEVER,
    GTK_POLICY_EXTERNAL
};

class Widget;
class SignalConnection;
class Application;

class SignalConnection {
public:
    SignalConnection();
    void disconnect();
    bool connected() const;
    void *instance;
    unsigned long handler;
    void *action;
    void *data;
    int live;
    Widget *owner;
    void *anchor;
    int anchorKind;
};

class Application {
public:
    Application(const char *id);
    ~Application();
    SignalConnection on_activate(
            void (*action)(void *),
            void *data);
    int run();
    void quit();
    long post(void (*action)(void *), void *data);
    bool cancel(long token);
    void *native;
    int running;
    int finished;
    long nextToken;
    Widget **widgets;
    long widgetCount;
    long widgetRoom;
    SignalConnection **slots;
    long slotCount;
    long slotRoom;
    void **posts;
    long postRoom;
    void *lock;
};

class Widget {
public:
    Widget();
    virtual ~Widget();
    void dispose();
    bool disposed() const;
    void set_visible(bool value);
    void set_sensitive(bool value);
    void set_h_expand(bool value);
    void set_v_expand(bool value);
    void set_width_request(long width);
    void add_css_class(const char *name);
    void remove_css_class(const char *name);
    void set_tooltip(const char *text);
    void add_css(const char *css);
    void add_shortcut(
            const char *accel,
            void (*action)(void *),
            void *data);
    void *native;
    int gone;
    int kind;
    int disposing;
    Widget *parentWidget;
    Widget **children;
    long childCount;
    long childRoom;
    SignalConnection **slots;
    long slotCount;
    long slotRoom;
    void (*cleanup)(Widget *);
};

class Window : public Widget {
public:
    Window(const char *title);
    void set_title(const char *title);
    const char *title() const;
    void set_default_size(long width, long height);
    void set_child(Widget *child);
    void remove(Widget *child);
    void present();
    void close();
    void destroy();
    SignalConnection on_close_request(
            bool (*action)(void *),
            void *data);
};

class Box : public Widget {
public:
    Box(int orientation, int spacing);
    void append(Widget *child);
    void remove(Widget *child);
};

class Label : public Widget {
public:
    Label(const char *text);
    void set_text(const char *text);
    const char *text() const;
};

class Button : public Widget {
public:
    Button(const char *label);
    void set_label(const char *label);
    const char *label() const;
    SignalConnection on_clicked(
            void (*action)(void *),
            void *data);
};

class Entry : public Widget {
public:
    Entry(const char *text);
    void set_text(const char *text);
    const char *text() const;
    SignalConnection on_changed(
            void (*action)(void *),
            void *data);
};

class CheckButton : public Widget {
public:
    CheckButton(const char *label);
    void set_label(const char *label);
    const char *label() const;
    void set_active(bool value);
    bool active() const;
    SignalConnection on_toggled(
            void (*action)(void *, bool),
            void *data);
};

class ScrolledWindow : public Widget {
public:
    ScrolledWindow();
    void set_child(Widget *child);
    void remove(Widget *child);
    void set_policy(int horizontal, int vertical);
};

class HeaderBar : public Widget {
public:
    HeaderBar();
    void set_title(const char *title);
    const char *title() const;
    void set_show_title_buttons(bool value);
    bool show_title_buttons() const;
    void pack_start(Widget *child);
    void pack_end(Widget *child);
    void *titleLabel;
};

class MenuButton : public Widget {
public:
    MenuButton(const char *label);
    void set_label(const char *label);
    const char *label() const;
    void set_menu(
            const char **labels,
            long count,
            void (*action)(void *, const char *),
            void *data);
    void (*menuAction)(void *, const char *);
    void *menuData;
    void *menuModel;
    void *actionGroup;
    char **menuLabels;
    long menuCount;
    void **menuPicks;
};

class Popover : public Widget {
public:
    Popover();
    void set_child(Widget *child);
    void popup();
    void popdown();
};

class Paned : public Widget {
public:
    Paned(int orientation);
    int orientation() const;
    void set_start_child(Widget *child);
    void set_end_child(Widget *child);
    void set_position(long position);
    long position() const;
    Widget *startChild;
    Widget *endChild;
    int orient;
};

class Notebook : public Widget {
public:
    Notebook();
    long append_page(Widget *child, const char *title);
    void remove_page(long index);
    long current_page() const;
    void set_current_page(long index);
    void set_tab_label(long index, const char *title);
    void set_tab(long index, Widget *tab);
    SignalConnection on_switch_page(
            void (*action)(void *, long),
            void *data);
};

class ColumnView : public Widget {
public:
    ColumnView();
    void append_column(const char *title);
    void append_row(const char **cells, long count);
    void clear_rows();
    long row_count() const;
    long column_count() const;
    const char *cell(long row, long column) const;
    SignalConnection on_activate(
            void (*action)(void *, long),
            void *data);
    void **cells;
    long rowCount;
    long rowRoom;
    long columnCount;
    void *rows;
    void **columnData;
};

class Dialog : public Widget {
public:
    Dialog(const char *title);
    void set_title(const char *title);
    const char *title() const;
    void set_content(Widget *child);
    void add_button(const char *label, int response);
    SignalConnection on_response(
            void (*action)(void *, int),
            void *data);
    void present();
    void set_transient(Window *parent);
    Widget *content;
    Window *transientParent;
};

class AlertDialog {
public:
    AlertDialog(
            const char *message,
            const char *detail);
    ~AlertDialog();
    const char *message() const;
    const char *detail() const;
    void present(void (*confirm)(void *), void *data);
    void *native;
    void (*confirmAction)(void *);
    void *confirmData;
    int pending;
};

class FileDialog {
public:
    FileDialog();
    ~FileDialog();
    void set_title(const char *title);
    const char *title() const;
    void open(
            void (*action)(void *, const char *),
            void *data);
    void save(
            void (*action)(void *, const char *),
            void *data);
    void set_parent(Window *parent);
    void *native;
    void *parentWindow;
    char *titleText;
    void (*pick)(void *, const char *);
    void *pickData;
    int pending;
    int saving;
    char *picked;
};

class FontDialog {
public:
    FontDialog();
    ~FontDialog();
    void choose(
            Window *parent,
            void (*action)(void *, const char *),
            void *data);
    void *native;
    void (*pick)(void *, const char *);
    void *pickData;
    int pending;
    char *picked;
};

class DropDown : public Widget {
public:
    DropDown();
    void set_items(const char **items, long count);
    void set_selected(long index);
    long selected() const;
    const char *selected_string() const;
    SignalConnection on_changed(
            void (*action)(void *),
            void *data);
    char **items;
    long itemCount;
};

class SpinButton : public Widget {
public:
    SpinButton(double min, double max, double value);
    double min() const;
    double max() const;
    double value() const;
    void set_value(double value);
    SignalConnection on_changed(
            void (*action)(void *),
            void *data);
};

class Picture : public Widget {
public:
    Picture();
    void set_file(const char *path);
    const char *file() const;
    char *path;
};

class ProgressBar : public Widget {
public:
    ProgressBar();
    void set_fraction(double fraction);
    double fraction() const;
};

class Spinner : public Widget {
public:
    Spinner();
    void start();
    void stop();
    bool spinning() const;
};

class TextIter {
public:
    TextIter(long line, long offset);
    long line() const;
    long offset() const;
    long lineNumber;
    long charOffset;
};

class TextMark;
class TextBuffer;

class TextMark {
public:
    TextMark(
            TextBuffer *buffer,
            const char *name,
            long line,
            long offset);
    ~TextMark();
    const char *name() const;
    void move(long line, long offset);
    long line() const;
    long offset() const;
    void *native;
    TextBuffer *buffer;
    char *ownedName;
};

class TextBuffer {
public:
    TextBuffer();
    ~TextBuffer();
    void set_text(const char *text);
    const char *get_text();
    void insert(TextIter *at, const char *text);
    void delete_range(TextIter *start, TextIter *end);
    void place_cursor(TextIter *at);
    void select_range(TextIter *start, TextIter *end);
    bool selection_bounds(
            TextIter *start,
            TextIter *end);
    void create_tag(
            const char *name,
            const char *foreground);
    void set_tag_background(
            const char *name,
            const char *color);
    void apply_tag(
            const char *name,
            TextIter *start,
            TextIter *end);
    void remove_tag(
            const char *name,
            TextIter *start,
            TextIter *end);
    void undo();
    void redo();
    SignalConnection on_changed(
            void (*action)(void *),
            void *data);
    TextMark *create_mark(
            const char *name,
            long line,
            long offset);
    void *native;
    char *ownedText;
    SignalConnection **slots;
    long slotCount;
    long slotRoom;
};

class TextView : public Widget {
public:
    TextView(TextBuffer *buffer);
    void set_editable(bool value);
    bool editable() const;
    void set_monospace(bool value);
    bool monospace() const;
    void scroll_to(long line, long offset);
    void set_line_numbers(bool value);
    bool line_numbers() const;
    const char *line_number_text();
    long line_number_origin(long line) const;
    void set_font(const char *description);
    void set_column_marker(long column, const char *color);
    SignalConnection on_move_cursor(
            void (*action)(void *, long, long),
            void *data);
    TextBuffer *buffer;
    int showNumbers;
    int numberHook;
    Widget *columnMark;
    void *numberArea;
    void *numberAdjust;
    char numberChars[512];
};

}

#endif
