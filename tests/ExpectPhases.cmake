if(NOT DEFINED SCPP OR NOT DEFINED PREPROC OR NOT DEFINED CC OR NOT DEFINED CLANG
        OR NOT DEFINED SOURCE OR NOT DEFINED OUTPUT OR NOT DEFINED WORK OR NOT DEFINED LOG)
    message(FATAL_ERROR "phase check is missing a path")
endif()
if(NOT DEFINED EXPECT_STATUS)
    set(EXPECT_STATUS 0)
endif()

function(write_wrapper path phase tool)
    file(WRITE "${path}"
"#!/bin/sh
{
  echo \"PHASE ${phase}\"
  for arg in \"\$@\"; do
    printf '%s\\n' \"\$arg\"
  done
  echo END
} >> \"${LOG}\"
exec \"${tool}\" \"\$@\"
")
    execute_process(COMMAND chmod +x "${path}")
endfunction()

file(MAKE_DIRECTORY "${WORK}")
file(REMOVE "${LOG}")
write_wrapper("${WORK}/preproc.sh" preproc "${PREPROC}")
write_wrapper("${WORK}/cc.sh" scpp_cc "${CC}")
write_wrapper("${WORK}/clang.sh" clang "${CLANG}")

set(ENV{SMALLCPP_PREPROC} "${WORK}/preproc.sh")
set(ENV{SMALLCPP_CC} "${WORK}/cc.sh")
set(ENV{SMALLCPP_CLANGXX} "${WORK}/clang.sh")
if(DEFINED PPENV)
    set(ENV{PPENV} "${PPENV}")
endif()

set(phase_args "")
if(DEFINED PHASE_ARGS AND NOT PHASE_ARGS STREQUAL "")
    string(REPLACE "|" ";" phase_args "${PHASE_ARGS}")
endif()

execute_process(
    COMMAND "${SCPP}" ${phase_args} "${SOURCE}"
    RESULT_VARIABLE status
    OUTPUT_VARIABLE shown_out
    ERROR_VARIABLE shown_err)
if(NOT status EQUAL EXPECT_STATUS)
    message(FATAL_ERROR "scpp status ${status}, expected ${EXPECT_STATUS}\n${shown_out}${shown_err}")
endif()

if(DEFINED NEEDLE)
    string(FIND "${shown_out}${shown_err}" "${NEEDLE}" needle_at)
    if(needle_at EQUAL -1)
        message(FATAL_ERROR "output is missing '${NEEDLE}'\n${shown_out}${shown_err}")
    endif()
endif()
if(DEFINED ABSENT)
    string(FIND "${shown_out}${shown_err}" "${ABSENT}" absent_at)
    if(NOT absent_at EQUAL -1)
        message(FATAL_ERROR "output contains '${ABSENT}'\n${shown_out}${shown_err}")
    endif()
endif()

function(split_pipes text out)
    if("${text}" STREQUAL "")
        set(${out} "" PARENT_SCOPE)
    else()
        string(REPLACE "|" ";" items "${text}")
        set(${out} "${items}" PARENT_SCOPE)
    endif()
endfunction()

function(phase_body phase out_var found_var)
    set(body "")
    set(found 0)
    if(EXISTS "${LOG}")
        file(STRINGS "${LOG}" lines)
        set(collecting 0)
        foreach(line IN LISTS lines)
            if(line MATCHES "^PHASE ")
                if(line STREQUAL "PHASE ${phase}")
                    set(collecting 1)
                    set(found 1)
                else()
                    set(collecting 0)
                endif()
            elseif(line STREQUAL "END")
                set(collecting 0)
            elseif(collecting)
                string(APPEND body "${line}\n")
            endif()
        endforeach()
    endif()
    set(${out_var} "${body}" PARENT_SCOPE)
    set(${found_var} "${found}" PARENT_SCOPE)
endfunction()

function(require_tokens body label has lacks)
    set(haystack "\n${body}")
    if(NOT "${has}" STREQUAL "")
        split_pipes("${has}" tokens)
        foreach(token IN LISTS tokens)
            string(FIND "${haystack}" "\n${token}\n" at)
            if(at EQUAL -1)
                message(FATAL_ERROR "${label} is missing '${token}'\n${body}")
            endif()
        endforeach()
    endif()
    if(NOT "${lacks}" STREQUAL "")
        split_pipes("${lacks}" tokens)
        foreach(token IN LISTS tokens)
            string(FIND "${haystack}" "\n${token}\n" at)
            if(NOT at EQUAL -1)
                message(FATAL_ERROR "${label} received '${token}'\n${body}")
            endif()
        endforeach()
    endif()
endfunction()

if(NOT DEFINED PREPROC_HAS)
    set(PREPROC_HAS "")
endif()
if(NOT DEFINED PREPROC_LACKS)
    set(PREPROC_LACKS "")
endif()
if(NOT DEFINED CC_HAS)
    set(CC_HAS "")
endif()
if(NOT DEFINED CC_LACKS)
    set(CC_LACKS "")
endif()
if(NOT DEFINED CLANG_HAS)
    set(CLANG_HAS "")
endif()
if(NOT DEFINED CLANG_LACKS)
    set(CLANG_LACKS "")
endif()

phase_body(preproc preproc_body preproc_found)
phase_body(scpp_cc cc_body cc_found)
phase_body(clang clang_body clang_found)

if(DEFINED NO_PHASES)
    if(preproc_found OR cc_found OR clang_found)
        message(FATAL_ERROR "a phase ran\n${preproc_body}${cc_body}${clang_body}")
    endif()
else()
    if(NOT preproc_found)
        message(FATAL_ERROR "preproc did not run")
    endif()
    require_tokens("${preproc_body}" preproc "${PREPROC_HAS}" "${PREPROC_LACKS}")
    if(NOT cc_found)
        message(FATAL_ERROR "scpp_cc did not run")
    endif()
    require_tokens("${cc_body}" scpp_cc "${CC_HAS}" "${CC_LACKS}")
endif()

if(DEFINED CLANG_ABSENT)
    if(clang_found)
        message(FATAL_ERROR "clang ran\n${clang_body}")
    endif()
elseif(NOT DEFINED NO_PHASES)
    if(NOT clang_found)
        message(FATAL_ERROR "clang did not run")
    endif()
    require_tokens("${clang_body}" clang "${CLANG_HAS}" "${CLANG_LACKS}")
endif()

if(DEFINED MAGIC)
    execute_process(
        COMMAND python3 -c "import pathlib,sys; b=pathlib.Path(sys.argv[1]).read_bytes()[:4]; want=bytes([0x42,0x43,0xc0,0xde]) if sys.argv[2]=='bc' else bytes([0x7f,0x45,0x4c,0x46]); sys.exit(0 if b==want else 1)"
            "${OUTPUT}" "${MAGIC}"
        RESULT_VARIABLE magic_status)
    if(NOT magic_status EQUAL 0)
        message(FATAL_ERROR "${OUTPUT} is not ${MAGIC}")
    endif()
endif()

if(DEFINED KEEP_I)
    if(NOT EXISTS "${OUTPUT}.i")
        message(FATAL_ERROR "preprocessed file was removed")
    endif()
endif()
if(DEFINED KEEP_O)
    if(NOT EXISTS "${OUTPUT}.o")
        message(FATAL_ERROR "object file was removed")
    endif()
endif()
