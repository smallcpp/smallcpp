if(NOT DEFINED CC OR NOT DEFINED SOURCE)
    message(FATAL_ERROR "syntax-tree check is missing a path")
endif()
if(NOT DEFINED TEXT AND NOT DEFINED DOT AND NOT DEFINED BITCODE)
    message(FATAL_ERROR "syntax-tree check names no output")
endif()

set(args "")
if(DEFINED BITCODE)
    list(APPEND args -o "${BITCODE}")
endif()
if(DEFINED TEXT)
    list(APPEND args --ast-text "${TEXT}")
endif()
if(DEFINED DOT)
    list(APPEND args --ast-dot "${DOT}")
endif()

execute_process(
    COMMAND "${CC}" ${args} "${SOURCE}"
    RESULT_VARIABLE status
    ERROR_VARIABLE shown)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "scpp_cc failed\n${shown}")
endif()
if(NOT EXISTS "${SOURCE}")
    message(FATAL_ERROR "scpp_cc removed its input")
endif()

function(require_text path needle)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "missing ${path}")
    endif()
    file(READ "${path}" body)
    string(FIND "${body}" "${needle}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "${path} is missing '${needle}'\n${body}")
    endif()
endfunction()

if(DEFINED TEXT)
    require_text("${TEXT}" "translation-unit")
    require_text("${TEXT}" "main")
endif()
if(DEFINED DOT)
    require_text("${DOT}" "digraph")
    require_text("${DOT}" "translation-unit")
    require_text("${DOT}" "main")
endif()
if(DEFINED BITCODE)
    if(NOT DEFINED VERIFY)
        message(FATAL_ERROR "syntax-tree check is missing the module checker")
    endif()
    execute_process(
        COMMAND "${VERIFY}" return "${BITCODE}"
        RESULT_VARIABLE verify_status)
    if(NOT verify_status EQUAL 0)
        message(FATAL_ERROR "module check failed")
    endif()
endif()
