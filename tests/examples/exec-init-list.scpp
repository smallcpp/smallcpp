class Pair {
    int x;
    int y;
public:
    Pair(int ax, int ay) : x(ax), y(ay) {
    }
    int sum(void) {
        return x + y;
    }
};

int answer(void) {
    Pair *p;
    p = new Pair(2, 5);
    { int shown; shown = (int)(p->sum()); print("{:s} {}\n", "exec-init-list", shown); return shown; }
}
