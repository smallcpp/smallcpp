const int bias = 1;
volatile int steps;

int scale(int n) {
    int total;
    bool negative;

    negative = n < 0;
    if (negative)
        return 0;
    else
        total = bias;
    for (int i = 0; i < n; i = i + 1) {
        total = total + i;
        steps = steps + 1;
    }
    return total;
}

int forty_two() {
    return 42;
}

void touch(int n) {
    if (n)
        return;
    steps = n;
}

signed clip(signed n) {
    return -n;
}

unsigned long bits(unsigned long n) {
    return n >> 1;
}

signed char widen(signed char c) {
    return c + 1;
}

float half(float x) {
    return x / 2.0f;
}

double twice(double x) {
    return x * 2.0;
}

short add_short(short a, short b) {
    return a + b;
}

int bump(int n) {
    int a;
    int b;

    a = n;
    b = a++;
    ++a;
    a--;
    --a;
    return a + b;
}

int odds(int n) {
    int i;
    int total;

    total = 0;
    for (i = 0; i < n; i = i + 1) {
        if (i % 2 == 0)
            continue;
        total = total + i;
    }
    return total;
}

int mix(int a, int b) {
    int c;
    unsigned u;
    char ch;
    short s;
    long wide;
    float f;
    double d;
    const int fixed = 4;
    ch = 'A';
    ch = (char)a;
    s = (short)ch;
    u = (unsigned)b;
    wide = (long)a + (long)b;
    f = (float)a / 2.0f;
    d = f * 1.5;
    c = a > b ? a : b;
    c = c << 1;
    c = c >> 1;
    c = c & 7;
    c = c | 1;
    c = c ^ 1;
    c = ~c;
    c = +c;
    c = (int)sizeof(int);
    c = (int)sizeof c;
    if (a && b || !b)
        c = c + 1;
    c = (a, b);
    c += fixed;
    c *= 2;
    c -= 1;
    c /= 2;
    c %= 5;
    while (c > 10)
        c = c - 1;
    return c + (int)wide + (int)d + (int)u + s;
}

int control(int n) {
    int total;
    int i;

    total = 0;
    switch (n) {
    case 0:
        total = 1;
        break;
    case 1:
        total = 2;
        goto done;
    default:
        total = n;
        break;
    }
done:
    i = 0;
    do {
        i = i + 1;
        if (i == 1)
            continue;
        if (i > n)
            break;
    } while (i < 3);
    return total + i;
}
