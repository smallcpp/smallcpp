#include <dirent>
#include <fcntl>
#include <libgen>
#include <stat>
#include <stdlib>
#include <unistd>

void copy_text(char *buf, const char *text) {
    long i;

    i = 0;
    while (text[i] != 0) {
        buf[i] = text[i];
        i = i + 1;
    }
    buf[i] = 0;
}

void join_path(char *buf, const char *dir, const char *name) {
    long i;
    long n;

    i = 0;
    while (dir[i] != 0) {
        buf[i] = dir[i];
        i = i + 1;
    }
    buf[i] = '/';
    i = i + 1;
    n = 0;
    while (name[n] != 0) {
        buf[i] = name[n];
        i = i + 1;
        n = n + 1;
    }
    buf[i] = 0;
}

int same(const char *left, const char *right) {
    long i;

    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}

int main(void) {
    char pattern[40];
    char path[80];
    char dest[80];
    char sub[80];
    char copy[80];
    char name[32];
    char data[8];
    char *dir;
    char *base;
    struct stat info;
    DIR *listing;
    struct dirent *entry;
    int fd;
    int out;
    int found;
    long copied;
    long n;

    if ((long)sizeof(struct stat) != 144)
        return 1;
    if ((long)sizeof(struct dirent) != 280)
        return 1;
    copy_text(pattern, "/tmp/scpp-fs-XXXXXX");
    dir = mkdtemp(pattern);
    if (dir == nullptr)
        return 1;
    join_path(sub, dir, "sub");
    if (mkdir(sub, 448) != 0)
        return 1;
    if (rmdir(sub) != 0)
        return 1;
    join_path(path, dir, "note");
    fd = open(path, O_CREAT | O_WRONLY | O_TRUNC, 420);
    if (fd < 0)
        return 1;
    if (write(fd, (void *)"note", 4) != 4 || close(fd) != 0)
        return 1;
    if (access(path, R_OK) != 0)
        return 1;
    if (stat(path, &info) != 0 || lstat(path, &info) != 0)
        return 1;
    if (S_ISREG(info.st_mode) == 0 || info.st_size != 4)
        return 1;
    join_path(dest, dir, "copy");
    out = open(dest, O_CREAT | O_WRONLY | O_TRUNC, 420);
    fd = open(path, O_RDONLY);
    if (fd < 0 || out < 0)
        return 1;
    copied = copy_file_range(fd, nullptr, out, nullptr, 4, 0);
    if (close(fd) != 0 || close(out) != 0 || copied != 4)
        return 1;
    listing = opendir(dir);
    if (listing == nullptr)
        return 1;
    found = 0;
    entry = readdir(listing);
    while (entry != nullptr) {
        if (same(entry->d_name, "note"))
            found = 1;
        entry = readdir(listing);
    }
    if (closedir(listing) != 0 || found == 0)
        return 1;
    copy_text(copy, path);
    base = basename(copy);
    if (base == nullptr)
        return 1;
    n = 0;
    while (base[n] != 0 && n < 31) {
        name[n] = base[n];
        n = n + 1;
    }
    name[n] = 0;
    copy_text(copy, path);
    if (dirname(copy) == nullptr)
        return 1;
    fd = open(dest, O_RDONLY);
    if (fd < 0)
        return 1;
    n = read(fd, (void *)data, 4);
    if (close(fd) != 0 || n != 4)
        return 1;
    if (unlink(path) != 0 || unlink(dest) != 0)
        return 1;
    if (rmdir(dir) != 0)
        return 1;
    print("fs-dir {} {:s} {}\n", info.st_size, name, copied);
    return 0;
}
