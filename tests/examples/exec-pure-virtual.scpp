class Base {
public:
    virtual int id(void) = 0;
};

class Derived : public Base {
public:
    int id(void) {
        return 8;
    }
};

int answer(void) {
    Derived *object;
    Base *base;
    object = new Derived();
    base = object;
    { int shown; shown = (int)(base->id()); print("{:s} {}\n", "exec-pure-virtual", shown); return shown; }
}
