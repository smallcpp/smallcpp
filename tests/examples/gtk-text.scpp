#include <exceptions>
#include <gtk>

using namespace Gtk;

static int edits;
static int keyed;

static void key_hit(void *data) {
    int *flag;

    flag = (int *)data;
    *flag = 1;
}

static int same_text(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == 0 && right[i] == 0)
        return 1;
    return 0;
}

static int has_digit(const char *text) {
    long i;

    if (text == nullptr)
        return 0;
    i = 0;
    while (text[i] != 0) {
        if (text[i] == '1')
            return 1;
        i = i + 1;
    }
    return 0;
}

static void buffer_changed(void *data) {
    int *flag;

    flag = (int *)data;
    *flag = *flag + 1;
}

static void copy_text(
        char *dest,
        const char *src,
        long room) {
    long i;

    i = 0;
    if (src == nullptr) {
        dest[0] = 0;
        return;
    }
    while (src[i] != 0 && i + 1 < room) {
        dest[i] = src[i];
        i = i + 1;
    }
    dest[i] = 0;
}

int main(void) {
    TextBuffer *buffer;
    TextMark *mark;
    TextIter *at;
    TextIter *start;
    TextIter *end;
    TextView *view;
    char inserted[8];
    char undone[8];
    long place;
    long endAt;

    try {
        buffer = new TextBuffer();
        edits = 0;
        buffer->on_changed(buffer_changed, (void *)&edits);
        buffer->set_text("ab");
        mark = buffer->create_mark("caret", 0, 1);
        at = new TextIter(0, 1);
        buffer->insert(at, "X");
        copy_text(inserted, buffer->get_text(), 8);
        place = mark->offset();
        buffer->undo();
        copy_text(undone, buffer->get_text(), 8);
        buffer->set_text("hello");
        start = new TextIter(0, 0);
        end = new TextIter(0, 5);
        buffer->select_range(start, end);
        buffer->selection_bounds(start, end);
        buffer->create_tag("note", "blue");
        buffer->apply_tag("note", start, end);
        view = new TextView(buffer);
        view->set_monospace(true);
        view->set_editable(false);
        view->scroll_to(0, 0);
        keyed = 0;
        view->add_shortcut(
                "<Control>s",
                key_hit,
                (void *)&keyed);
        view->set_line_numbers(true);
        view->set_font("Monospace 12");
        view->set_column_marker(80, "#cccccc");
        view->set_column_marker(0, "#cccccc");
        buffer->set_tag_background("note", "#eeeeee");
        buffer->set_tag_foreground("note", "blue");
        buffer->set_tag_text_background("note", "#fff4cc");
        buffer->set_tag_bold("note", true);
        buffer->set_tag_bold("note", false);
        {
            Window *win;
            Dialog *ask;
            Notebook *book;
            FileDialog *files;
            FontDialog *fonts;
            ColorDialog *colors;

            win = new Window("w");
            ask = new Dialog("d");
            ask->set_transient(win);
            book = new Notebook();
            book->add_css(
                    "tab { border: 1px solid #666666; }");
            files = new FileDialog();
            files->set_parent(win);
            fonts = new FontDialog();
            colors = new ColorDialog();
            (void)fonts;
            (void)colors;
        }
        if (edits == 0)
            throw *new Exception("gtk");
        if (view->line_numbers() == false)
            throw *new Exception("gtk");
        if (has_digit(view->line_number_text()) == 0)
            throw *new Exception("gtk");
        endAt = end->offset();
        buffer->set_text("ab\ncd");
        at = new TextIter(0, 2);
        buffer->place_cursor(at);
        if (view->caret_count() != 1)
            throw *new Exception("gtk");
        if (view->add_caret(1, 2) == 0)
            throw *new Exception("gtk");
        if (view->caret_count() != 2)
            throw *new Exception("gtk");
        at = new TextIter(0, 2);
        buffer->insert(at, "Q");
        if (same_text(buffer->get_text(), "abQ\ncdQ") == 0)
            throw *new Exception("gtk");
        view->clear_carets();
        buffer->set_text("ab\ncd");
        at = new TextIter(0, 2);
        buffer->place_cursor(at);
        if (view->add_caret(1, 2) == 0)
            throw *new Exception("gtk");
        start = new TextIter(0, 1);
        end = new TextIter(0, 2);
        buffer->delete_range(start, end);
        if (same_text(buffer->get_text(), "a\nc") == 0)
            throw *new Exception("gtk");
        view->hold_carets(1);
        at = new TextIter(0, 1);
        buffer->place_cursor(at);
        buffer->insert(at, "Z");
        if (same_text(buffer->get_text(), "aZ\nc") == 0)
            throw *new Exception("gtk");
        view->hold_carets(0);
        view->clear_carets();
        if (view->caret_count() != 1)
            throw *new Exception("gtk");
        print("gtk-text {:s} {} {:s} {} {} {}\n",
                inserted,
                place,
                undone,
                endAt,
                (int)view->monospace(),
                (int)view->editable());
        return 0;
    } catch (Exception error) {
        if (error.message != nullptr
                && strcmp(error.message, "display") == 0) {
            print("SKIP gtk display\n");
            return 77;
        }
        if (error.message != nullptr)
            print("gtk-text fail {:s}\n", error.message);
        return 1;
    }
}
