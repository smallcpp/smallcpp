#include <list>

LIST(IntList, int)

int main(void) {
    IntList *items;

    items = new IntList();
    items->add(4);
    items->add(5);
    items->add(6);
    print("list {} {} {} {}\n",
        items->at(0),
        items->at(1),
        items->from_end(0),
        items->from_end(1));
    return 0;
}
