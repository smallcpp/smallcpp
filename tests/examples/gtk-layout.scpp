#include <exceptions>
#include <gtk>

using namespace Gtk;

int main(void) {
    Window *window;
    HeaderBar *bar;
    Paned *pane;
    Notebook *book;
    Label *page;

    try {
        window = new Window("Win");
        bar = new HeaderBar();
        bar->set_title("Title");
        bar->set_show_title_buttons(false);
        pane = new Paned(GTK_HORIZONTAL);
        pane->set_position(40);
        book = new Notebook();
        page = new Label("Page");
        book->append_page((Widget *)page, "Tab");
        print("gtk-layout {:s} {:s} {} {} {}\n",
                window->title(),
                bar->title(),
                (int)bar->show_title_buttons(),
                pane->position(),
                book->current_page());
        return 0;
    } catch (Exception error) {
        if (error.message != nullptr
                && strcmp(error.message, "display") == 0) {
            print("SKIP gtk display\n");
            return 77;
        }
        if (error.message != nullptr)
            print("gtk-layout fail {:s}\n", error.message);
        return 1;
    }
}
