#include <exceptions>
#include <gtk>

using namespace Gtk;

int main(void) {
    Dialog *dialog;
    AlertDialog *alert;
    FileDialog *files;
    Label *body;

    try {
        dialog = new Dialog("Ask");
        body = new Label("Body");
        dialog->set_content((Widget *)body);
        dialog->add_button("Close", 1);
        alert = new AlertDialog("Hello", "Detail");
        files = new FileDialog();
        files->set_title("Open");
        print("gtk-dialog {:s} {:s} {:s}\n",
                dialog->title(),
                alert->message(),
                files->title());
        return 0;
    } catch (Exception error) {
        if (error.message != nullptr
                && strcmp(error.message, "display") == 0) {
            print("SKIP gtk display\n");
            return 77;
        }
        if (error.message != nullptr)
            print("gtk-dialog fail {:s}\n", error.message);
        return 1;
    }
}
