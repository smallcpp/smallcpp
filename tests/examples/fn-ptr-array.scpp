int add(int left, int right) {
    return left + right;
}

int sub(int left, int right) {
    return left - right;
}

int main(void) {
    int (*fns[2])(int, int);
    int sum;
    int gap;

    fns[0] = add;
    fns[1] = sub;
    sum = fns[0](2, 5);
    gap = fns[1](5, 2);
    print("fn-ptr-array {} {}\n", sum, gap);
    return 0;
}
