int hits;

class Box {
public:
    ~Box() {
        hits = hits + 1;
    }
};

int main(void) {
    Box *p;
    int *q;
    p = new Box;
    delete p;
    if (hits != 1)
        { int shown; shown = (int)(2); print("{:s} {}\n", "exec-delete-dtor", shown); return shown; }
    p = nullptr;
    q = nullptr;
    q = new int;
    { int shown; shown = (int)(hits == 1 ? 5 : hits); print("{:s} {}\n", "exec-delete-dtor", shown); return shown; }
}
