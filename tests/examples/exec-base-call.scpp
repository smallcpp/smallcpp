class A {
public:
    int value(void) {
        return 1;
    }
};

class B : public A {
public:
    int value(void) {
        return 2;
    }
    int read(void) {
        return A::value();
    }
};

int answer(void) {
    B *b;
    b = new B();
    { int shown; shown = (int)(b->read()); print("{:s} {}\n", "exec-base-call", shown); return shown; }
}
