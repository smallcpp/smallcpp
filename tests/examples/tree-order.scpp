#include <tree>

TREE(RevTree, int)

long reverse(int left, int right) {
    if (left < right)
        return (long)1;
    if (right < left)
        return (long)-1;
    return (long)0;
}

int main(void) {
    RevTree *nodes;

    nodes = new RevTree(reverse);
    nodes->insert(0, 1);
    nodes->insert(0, 2);
    nodes->insert(0, 3);
    print("tree-order {} {} {} {}\n",
        nodes->at(0),
        nodes->at(1),
        nodes->at(2),
        (int)nodes->find(1));
    return 0;
}
