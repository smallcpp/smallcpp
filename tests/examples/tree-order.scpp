#include <tree>

TREE(IntTree, int)

class RevTree : public IntTree {
public:
    RevTree();
    long compare(int left, int right);
};

RevTree::RevTree() : IntTree() {
}

long RevTree::compare(int left, int right) {
    if (left < right)
        return (long)1;
    if (right < left)
        return (long)-1;
    return (long)0;
}

int main(void) {
    RevTree *nodes;

    nodes = new RevTree();
    nodes->add(1);
    nodes->add(2);
    nodes->add(3);
    print("tree-order {} {} {} {}\n",
        nodes->at(0),
        nodes->at(1),
        nodes->at(2),
        (int)nodes->find(1));
    return 0;
}
