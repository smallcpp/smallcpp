#include <vector>

VECTOR(IntVec, int)

int main(void) {
    IntVec *values;

    values = new IntVec();
    values->add(10);
    values->add(20);
    values->add(30);
    values->add(40);
    values->add(50);
    print("vector {} {} {} {} {} {}\n",
        (int)values->size(),
        values->at(0),
        values->at(1),
        values->at(2),
        values->at(3),
        values->at(4));
    return 0;
}
