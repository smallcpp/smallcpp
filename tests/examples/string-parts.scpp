#include <string>

int main(void) {
    String *text;
    String *bits;
    String *marks;
    String *whole;
    String *joined;
    String *flat;
    String *wide;
    String *piece;
    StringVec *parts;
    StringVec *cuts;
    StringVec *one;
    const char *comma;
    const char *second;
    const char *colon;
    const char *next;
    const char *done;
    long cursor;
    int end;

    text = new String();
    text->add("a,,b");
    parts = new StringVec();
    text->split(',', parts);
    joined = new String();
    joined->join('-', parts);
    flat = new String();
    flat->join("", parts);
    cursor = 0;
    comma = text->token(&cursor, ',');
    done = text->token(&cursor, ',');
    done = text->token(&cursor, ',');
    end = 0;
    if (done == nullptr)
        end = 1;
    bits = new String();
    bits->add("a::b::");
    cuts = new StringVec();
    bits->split("::", cuts);
    wide = new String();
    wide->join(",", cuts);
    cursor = 0;
    second = bits->token(&cursor, ':');
    second = bits->token(&cursor, ':');
    marks = new String();
    marks->add("a:b,c");
    cursor = 0;
    colon = marks->token(&cursor, ":,");
    next = marks->token(&cursor, ":,");
    whole = new String();
    whole->add("hi");
    one = new StringVec();
    whole->split('z', one);
    piece = one->at(0);
    print(
            "parts {} {:s} {:s} {:s} {:s} {} {:s} {:s} {:s} {:s} {} {:s} {}\n",
            (int)parts->size(),
            joined->chars(),
            flat->chars(),
            comma,
            text->chars(),
            (int)cuts->size(),
            wide->chars(),
            second,
            colon,
            next,
            (int)one->size(),
            piece->chars(),
            end);
    return 0;
}
