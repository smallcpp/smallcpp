#include <string>

int main(void) {
    String *text;
    String *bits;
    String *marks;
    String *whole;
    String *joined;
    String *flat;
    String *wide;
    String *piece;
    StringVec *parts;
    StringVec *cuts;
    StringVec *one;
    const char *comma;
    const char *second;
    const char *colon;
    const char *next;
    const char *done;
    long cursor;
    int end;

    text = new String();
    text->append("a,,b");
    parts = text->split(",");
    joined = text->join(parts, "-");
    flat = text->join(parts, "");
    cursor = 0;
    comma = text->token(&cursor, ',');
    done = text->token(&cursor, ',');
    done = text->token(&cursor, ',');
    end = 0;
    if (done == nullptr)
        end = 1;
    bits = new String();
    bits->append("a::b::");
    cuts = bits->split("::");
    wide = bits->join(cuts, ",");
    cursor = 0;
    second = bits->token(&cursor, ':');
    second = bits->token(&cursor, ':');
    marks = new String();
    marks->append("a:b,c");
    cursor = 0;
    colon = marks->token(&cursor, ":,");
    next = marks->token(&cursor, ":,");
    whole = new String();
    whole->append("hi");
    one = whole->split("z");
    piece = one->at(0);
    print(
            "parts {} {:s} {:s} {:s} {:s} {} {:s} {:s} {:s} {:s} {} {:s} {}\n",
            (int)parts->size(),
            joined->c_str(),
            flat->c_str(),
            comma,
            text->c_str(),
            (int)cuts->size(),
            wide->c_str(),
            second,
            colon,
            next,
            (int)one->size(),
            piece->c_str(),
            end);
    return 0;
}
