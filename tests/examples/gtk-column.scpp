#include <exceptions>
#include <gtk>

using namespace Gtk;

int main(void) {
    ColumnView *view;
    const char *row[1];

    try {
        view = new ColumnView();
        view->append_column("Name");
        row[0] = "Ada";
        view->append_row(row, 1);
        print("gtk-column {} {:s}\n",
                view->row_count(),
                view->cell(0, 0));
        return 0;
    } catch (Exception error) {
        if (error.message != nullptr
                && strcmp(error.message, "display") == 0) {
            print("SKIP gtk display\n");
            return 77;
        }
        if (error.message != nullptr)
            print("gtk-column fail {:s}\n", error.message);
        return 1;
    }
}
