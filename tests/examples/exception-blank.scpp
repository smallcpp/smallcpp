#include <exceptions>

int main(void) {
    try {
        Exception *error;
        error = new Exception();
        throw *error;
    } catch (Exception error) {
        int shown;
        shown = 1;
        if (error.message == nullptr)
            shown = 0;
        print("{:s} {}\n", "exception-blank", shown);
        return shown;
    }
    return 1;
}
