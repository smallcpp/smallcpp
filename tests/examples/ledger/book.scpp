#ifdef LEDGER_AS_HEADER
#define LEDGER_BOOK_HEADER
#undef LEDGER_AS_HEADER
#endif

#define LEDGER_AS_HEADER
#include "account.scpp"
#undef LEDGER_AS_HEADER

#ifndef LEDGER_BOOK
#define LEDGER_BOOK

class Book {
    Account *held[4];
    int held_count;
public:
    Book();
    void add(Account *account);
    Account *at(int slot);
    int size(void);
};

#endif

#ifndef LEDGER_BOOK_HEADER

Book::Book() {
    held[0] = nullptr;
    held[1] = nullptr;
    held[2] = nullptr;
    held[3] = nullptr;
    held_count = 0;
}

void Book::add(Account *account) {
    if (held_count < 4) {
        held[held_count] = account;
        held_count = held_count + 1;
    }
}

Account *Book::at(int slot) {
    return held[slot];
}

int Book::size(void) {
    return held_count;
}

#endif
