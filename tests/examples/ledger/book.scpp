#include "book.shpp"

Book::Book() {
    held[0] = nullptr;
    held[1] = nullptr;
    held[2] = nullptr;
    held[3] = nullptr;
    held_count = 0;
}

void Book::add(Account *account) {
    if (held_count < 4) {
        held[held_count] = account;
        held_count = held_count + 1;
    }
}

Account *Book::at(int slot) {
    return held[slot];
}

int Book::size(void) {
    return held_count;
}
