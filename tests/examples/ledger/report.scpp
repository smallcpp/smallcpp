#include "report.shpp"

void report(Book *book) {
    int tally;
    int slot;
    Account *account;
    tally = 0;
    slot = 0;
    while (slot < book->size()) {
        account = book->at(slot);
        tally = tally + account->balance();
        slot = slot + 1;
    }
    print("cash {}\n", tally);
}
