#ifdef LEDGER_AS_HEADER
#define LEDGER_MONEY_HEADER
#undef LEDGER_AS_HEADER
#endif

#ifndef LEDGER_MONEY
#define LEDGER_MONEY

class Amount {
    int units;
public:
    Amount(int value);
    int read(void);
    void add(int value);
    void take(int value);
};

#endif

#ifndef LEDGER_MONEY_HEADER

Amount::Amount(int value) : units(value) {
}

int Amount::read(void) {
    return units;
}

void Amount::add(int value) {
    units = units + value;
}

void Amount::take(int value) {
    units = units - value;
}

#endif
