#ifdef LEDGER_AS_HEADER
#define LEDGER_ACCOUNT_HEADER
#undef LEDGER_AS_HEADER
#endif

#define LEDGER_AS_HEADER
#include "money.scpp"
#undef LEDGER_AS_HEADER

#ifndef LEDGER_ACCOUNT
#define LEDGER_ACCOUNT

class Account {
    Amount cash;
public:
    Account(int value);
    virtual int balance(void);
    virtual void deposit(int value);
    virtual void withdraw(int value);
};

class Checking : public Account {
public:
    Checking(int value);
    virtual int balance(void);
    virtual void deposit(int value);
    virtual void withdraw(int value);
};

class Savings : public Account {
public:
    Savings(int value);
    virtual int balance(void);
    virtual void deposit(int value);
    virtual void withdraw(int value);
};

#endif

#ifndef LEDGER_ACCOUNT_HEADER

Account::Account(int value) : cash(value) {
}

int Account::balance(void) {
    return cash.read();
}

void Account::deposit(int value) {
    cash.add(value);
}

void Account::withdraw(int value) {
    cash.take(value);
}

Checking::Checking(int value) : Account(value) {
}

int Checking::balance(void) {
    return Account::balance();
}

void Checking::deposit(int value) {
    Account::deposit(value);
}

void Checking::withdraw(int value) {
    Account::withdraw(value + 1);
}

Savings::Savings(int value) : Account(value) {
}

int Savings::balance(void) {
    return Account::balance();
}

void Savings::deposit(int value) {
    Account::deposit(value);
}

void Savings::withdraw(int value) {
    Account::withdraw(value);
}

#endif
