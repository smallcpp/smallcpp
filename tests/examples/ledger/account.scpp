#include "account.shpp"

Account::Account(int value) : cash(value) {
}

int Account::balance(void) {
    return cash.read();
}

void Account::deposit(int value) {
    cash.add(value);
}

void Account::withdraw(int value) {
    cash.take(value);
}

Checking::Checking(int value) : Account(value) {
}

int Checking::balance(void) {
    return Account::balance();
}

void Checking::deposit(int value) {
    Account::deposit(value);
}

void Checking::withdraw(int value) {
    Account::withdraw(value + 1);
}

Savings::Savings(int value) : Account(value) {
}

int Savings::balance(void) {
    return Account::balance();
}

void Savings::deposit(int value) {
    Account::deposit(value);
}

void Savings::withdraw(int value) {
    Account::withdraw(value);
}
