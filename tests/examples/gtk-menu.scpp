#include <exceptions>
#include <gtk>

using namespace Gtk;

static void picked(void *data, const char *label) {
    (void)data;
    (void)label;
}

int main(void) {
    MenuButton *button;
    Popover *popover;
    Label *label;
    const char *labels[1];

    try {
        button = new MenuButton("Open");
        labels[0] = "Quit";
        button->set_menu(labels, 1, picked, nullptr);
        popover = new Popover();
        label = new Label("Hello");
        popover->set_child((Widget *)label);
        print("gtk-menu {:s} {:s}\n",
                button->label(),
                label->text());
        return 0;
    } catch (Exception error) {
        if (error.message != nullptr
                && strcmp(error.message, "display") == 0) {
            print("SKIP gtk display\n");
            return 77;
        }
        if (error.message != nullptr)
            print("gtk-menu fail {:s}\n", error.message);
        return 1;
    }
}
