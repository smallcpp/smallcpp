class Base {
public:
    Base() {
    }
    virtual int id(void) {
        return 1;
    }
};

class Derived : public Base {
public:
    Derived() {
    }
    int id(void) {
        return 7;
    }
};

int answer(void) {
    Derived *d;
    Base *p;
    d = new Derived();
    p = d;
    { int shown; shown = (int)(p->id()); print("{:s} {}\n", "exec-base-virtual", shown); return shown; }
}
