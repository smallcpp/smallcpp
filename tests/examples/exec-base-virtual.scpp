class Base {
public:
    Base() {
    }
    virtual int id(void) {
        return 1;
    }
};

class Derived : public Base {
public:
    Derived() {
    }
    int id(void) {
        return 7;
    }
};

int answer(void) {
    Derived *d;
    Base *p;
    d = new Derived();
    p = d;
    return p->id();
}
