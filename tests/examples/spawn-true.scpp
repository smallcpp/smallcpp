#include <signal>
#include <spawn>
#include <unistd>

void zero(void *ptr, long n) {
    char *bytes;
    long i;

    bytes = (char *)ptr;
    i = 0;
    while (i < n) {
        bytes[i] = 0;
        i = i + 1;
    }
}

int run(const char *file) {
    char arg0[8];
    char *args[2];
    pid_t pid;
    int status;
    int rc;
    long i;

    i = 0;
    while (file[i] != 0 && i < 7) {
        arg0[i] = file[i];
        i = i + 1;
    }
    arg0[i] = 0;
    args[0] = arg0;
    args[1] = nullptr;
    pid = 0;
    rc = posix_spawnp(&pid, file, nullptr, nullptr, args, nullptr);
    if (rc != 0)
        return -1;
    status = 0;
    if (waitpid(pid, &status, 0) < 0)
        return -1;
    if (WIFEXITED(status) == 0)
        return -1;
    return WEXITSTATUS(status);
}

int main(void) {
    posix_spawn_file_actions_t actions;
    posix_spawnattr_t attr;
    struct sigaction action;
    int fds[2];
    int extra;
    int truth;
    int lie;

    if ((long)sizeof(posix_spawn_file_actions_t) != 80)
        return 1;
    if ((long)sizeof(posix_spawnattr_t) != 336)
        return 1;
    if ((long)sizeof(struct sigaction) != 152)
        return 1;
    extra = 0;
    if (pipe(fds) != 0)
        extra = 1;
    else {
        if (close(fds[0]) != 0 || close(fds[1]) != 0)
            extra = 1;
    }
    zero((void *)&action, (long)sizeof(action));
    action.sa_handler = SIG_IGN;
    if (sigaction(SIGPIPE, &action, nullptr) != 0)
        extra = 1;
    if (posix_spawn_file_actions_init(&actions) != 0)
        extra = 1;
    if (posix_spawn_file_actions_destroy(&actions) != 0)
        extra = 1;
    if (posix_spawnattr_init(&attr) != 0)
        extra = 1;
    if (posix_spawnattr_setflags(&attr, POSIX_SPAWN_SETPGROUP) != 0)
        extra = 1;
    if (posix_spawnattr_setpgroup(&attr, 0) != 0)
        extra = 1;
    if (posix_spawnattr_destroy(&attr) != 0)
        extra = 1;
    truth = run("true");
    lie = run("false");
    print("spawn-true {} {} {}\n", truth, lie, extra);
    return 0;
}
