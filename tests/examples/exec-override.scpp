class Base {
public:
    Base() {
    }
    virtual int id(void) {
        return 1;
    }
};

class Derived : public Base {
public:
    Derived() {
    }
    int id(void) {
        return 6;
    }
};

int main(void) {
    Derived *p;
    p = new Derived();
    { int shown; shown = (int)(p->id()); print("{:s} {}\n", "exec-override", shown); return shown; }
}
