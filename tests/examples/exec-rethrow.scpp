int main(void) {
    try {
        try {
            throw 4;
        } catch (...) {
            throw;
        }
    } catch (int error) {
        { int shown; shown = (int)(error); print("{:s} {}\n", "exec-rethrow", shown); return shown; }
    }
    { int shown; shown = (int)(0); print("{:s} {}\n", "exec-rethrow", shown); return shown; }
}
