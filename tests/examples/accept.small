/* A translation unit the grammar accepts. */

sc_namespace(audio)

sc_class Point {
sc_public
    int x;
sc_private
    int y;
};

sc_class Derived {
sc_public
    sc_base(Point);
    int z;
};

sc_virtual
sc_method
int sc_qual(point, move)(sc_class Point *self, int dx) {
    self->x = self->x + dx;
    sc_try {
        if (dx < 0)
            sc_throw(dx);
    } sc_catch(int e) {
        return e;
    }
    return self->x;
}

sc_end_namespace

int main(void) {
    sc_class Derived *p;
    const char *message;

    message = "hello";
    p = sc_new(sc_class Derived);
    p->z = 1;
    return sc_qual(point, move)(&p->sc_base_member, 2);
}
