int hits;

class Base {
public:
    virtual ~Base() {
    }
};

class Derived : public Base {
public:
    ~Derived() {
        hits = hits + 1;
    }
};

int answer(void) {
    Base *p;
    int *q;
    p = new Derived();
    if (hits != 0)
        { int shown; shown = (int)(2); print("{:s} {}\n", "exec-virtual-collect", shown); return shown; }
    p = nullptr;
    q = nullptr;
    q = new int;
    { int shown; shown = (int)(hits == 1 ? 9 : hits); print("{:s} {}\n", "exec-virtual-collect", shown); return shown; }
}
