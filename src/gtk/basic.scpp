/* Windows, boxes, labels, buttons, entries,
 * checks, and scrolled windows. */
#include <gtk.shpp>
#include <exceptions>
#include "gtk-native"
#include "gtk-globals"
#include "key.shpp"

namespace Gtk {

static void *handler_of(void (*typed)(void *, void *)) {
    return (void *)typed;
}

static void *action_of(void (*typed)(void *)) {
    return (void *)typed;
}

static int window_close(void *window, void *data) {
    SignalConnection *slot;
    bool (*action)(void *);

    (void)window;
    slot = (SignalConnection *)data;
    action = (bool (*)(void *))slot->action;
    if (slot->live == 0 || action == nullptr)
        return 0;
    if (action(slot->data))
        return 1;
    return 0;
}

static void button_clicked(void *button, void *data) {
    SignalConnection *slot;
    void (*action)(void *);

    (void)button;
    slot = (SignalConnection *)data;
    action = (void (*)(void *))slot->action;
    if (slot->live != 0 && action != nullptr)
        action(slot->data);
}

static void entry_changed(void *entry, void *data) {
    SignalConnection *slot;
    void (*action)(void *);

    (void)entry;
    slot = (SignalConnection *)data;
    action = (void (*)(void *))slot->action;
    if (slot->live != 0 && action != nullptr)
        action(slot->data);
}

static void check_toggled(void *button, void *data) {
    SignalConnection *slot;
    void (*action)(void *, bool);
    int active;

    slot = (SignalConnection *)data;
    action = (void (*)(void *, bool))slot->action;
    if (slot->live == 0 || action == nullptr)
        return;
    active = gtk_check_button_get_active(button);
    if (active != 0)
        action(slot->data, true);
    else
        action(slot->data, false);
}

Window::Window(const char *title) : Widget() {
    gtk_check_text(title);
    kind = GTK_KIND_WINDOW;
    native = gtk_sink(gtk_window_new());
    gtk_window_set_title(native, title);
}

void Window::set_title(const char *title) {
    gtk_use((Widget *)this);
    gtk_check_text(title);
    gtk_window_set_title(native, title);
}

const char *Window::title() const {
    gtk_use((Widget *)this);
    return gtk_text_or_empty(gtk_window_get_title(native));
}

static void surface_layout(
        void *surface,
        int width,
        int height,
        void *data) {
    SignalConnection *slot;
    void (*action)(void *, long, long);

    (void)surface;
    slot = (SignalConnection *)data;
    if (slot == nullptr || slot->live == 0)
        return;
    action = (void (*)(void *, long, long))slot->action;
    if (action == nullptr)
        return;
    action(slot->data, (long)width, (long)height);
}

static void bind_layout(void *widget, SignalConnection *slot) {
    void *surface;
    void (*typed)(void *, int, int, void *);
    unsigned long id;

    if (widget == nullptr || slot == nullptr)
        return;
    surface = gtk_native_get_surface(widget);
    if (surface == nullptr)
        return;
    if (g_object_get_data(surface, "smallcpp-layout") != nullptr)
        return;
    typed = surface_layout;
    id = g_signal_connect_data(
            surface,
            "layout",
            (void *)typed,
            (void *)slot,
            nullptr,
            0);
    if (id == 0)
        return;
    g_object_set_data(surface, "smallcpp-layout", (void *)slot);
}

static void window_realized(void *widget, void *data) {
    bind_layout(widget, (SignalConnection *)data);
}

void Window::set_default_size(long width, long height) {
    gtk_use((Widget *)this);
    gtk_window_set_default_size(
            native,
            gtk_int(width),
            gtk_int(height));
}

long Window::width() const {
    gtk_use((Widget *)this);
    return (long)gtk_widget_get_width(native);
}

long Window::height() const {
    gtk_use((Widget *)this);
    return (long)gtk_widget_get_height(native);
}

SignalConnection Window::on_resize(
        void (*action)(void *, long, long),
        void *data) {
    SignalConnection *slot;
    void (*typed)(void *, void *);
    void *handler;
    void *userAction;

    gtk_use((Widget *)this);
    if (action == nullptr)
        gtk_fail("null");
    typed = window_realized;
    handler = (void *)typed;
    userAction = (void *)action;
    slot = gtk_bind(
            native,
            "realize",
            handler,
            userAction,
            data,
            0);
    gtk_keep((Widget *)this, slot);
    bind_layout(native, slot);
    return *slot;
}

void Window::set_child(Widget *child) {
    gtk_check_child((Widget *)this, child);
    gtk_require_single((Widget *)this);
    gtk_window_set_child(native, child->native);
    gtk_note_child((Widget *)this, child);
}

void Window::remove(Widget *child) {
    gtk_use((Widget *)this);
    if (child == nullptr)
        gtk_fail("null");
    if (child->parentWidget != (Widget *)this)
        gtk_fail("child");
    gtk_window_set_child(native, nullptr);
    gtk_note_remove((Widget *)this, child);
}

void Window::present() {
    gtk_use((Widget *)this);
    gtk_present_window(native);
}

void Window::close() {
    gtk_use((Widget *)this);
    gtk_window_close(native);
}

void Window::destroy() {
    gtk_use((Widget *)this);
    gtk_window_destroy(native);
    native = nullptr;
    gone = 1;
}

SignalConnection Window::on_close_request(
        bool (*action)(void *),
        void *data) {
    SignalConnection *slot;
    int (*typed)(void *, void *);
    void *handler;
    void *userAction;

    gtk_use((Widget *)this);
    if (action == nullptr)
        gtk_fail("null");
    typed = window_close;
    handler = (void *)typed;
    userAction = (void *)action;
    slot = gtk_bind(
            native,
            "close-request",
            handler,
            userAction,
            data,
            0);
    gtk_keep((Widget *)this, slot);
    return *slot;
}

Box::Box(int orientation, int spacing) : Widget() {
    if (orientation != GTK_HORIZONTAL
            && orientation != GTK_VERTICAL)
        gtk_fail("range");
    native = gtk_sink(gtk_box_new(orientation, spacing));
}

Grid::Grid() : Widget() {
    native = gtk_sink(gtk_grid_new());
}

void Grid::attach(
        Widget *child,
        long column,
        long row,
        long width,
        long height) {
    gtk_check_child((Widget *)this, child);
    if (column < 0 || row < 0 || width < 1 || height < 1)
        gtk_fail("range");
    gtk_grid_attach(
            native,
            child->native,
            (int)column,
            (int)row,
            (int)width,
            (int)height);
    gtk_note_child((Widget *)this, child);
}

void Grid::set_spacing(int column, int row) {
    gtk_use((Widget *)this);
    if (column < 0 || row < 0)
        gtk_fail("range");
    gtk_grid_set_column_spacing(native, column);
    gtk_grid_set_row_spacing(native, row);
}

void Box::append(Widget *child) {
    gtk_check_child((Widget *)this, child);
    gtk_box_append(native, child->native);
    gtk_note_child((Widget *)this, child);
}

void Box::remove(Widget *child) {
    gtk_use((Widget *)this);
    if (child == nullptr)
        gtk_fail("null");
    if (child->parentWidget != (Widget *)this)
        gtk_fail("child");
    gtk_box_remove(native, child->native);
    gtk_note_remove((Widget *)this, child);
}

Label::Label(const char *text) : Widget() {
    gtk_check_text(text);
    native = gtk_sink(gtk_label_new(text));
}

void Label::set_text(const char *text) {
    gtk_use((Widget *)this);
    gtk_check_text(text);
    gtk_label_set_text(native, text);
}

const char *Label::text() const {
    gtk_use((Widget *)this);
    return gtk_text_or_empty(gtk_label_get_text(native));
}

Button::Button(const char *label) : Widget() {
    gtk_check_text(label);
    native = gtk_sink(gtk_button_new_with_label(label));
}

void Button::set_label(const char *label) {
    gtk_use((Widget *)this);
    gtk_check_text(label);
    gtk_button_set_label(native, label);
}

const char *Button::label() const {
    gtk_use((Widget *)this);
    return gtk_text_or_empty(gtk_button_get_label(native));
}

SignalConnection Button::on_clicked(
        void (*action)(void *),
        void *data) {
    SignalConnection *slot;
    void *handler;
    void *userAction;

    gtk_use((Widget *)this);
    if (action == nullptr)
        gtk_fail("null");
    handler = handler_of(button_clicked);
    userAction = action_of(action);
    slot = gtk_bind(
            native,
            "clicked",
            handler,
            userAction,
            data,
            0);
    gtk_keep((Widget *)this, slot);
    return *slot;
}

Entry::Entry(const char *text) : Widget() {
    gtk_check_text(text);
    native = gtk_sink(gtk_entry_new());
    gtk_editable_set_text(native, text);
}

void Entry::set_text(const char *text) {
    gtk_use((Widget *)this);
    gtk_check_text(text);
    gtk_editable_set_text(native, text);
}

const char *Entry::text() const {
    gtk_use((Widget *)this);
    return gtk_text_or_empty(gtk_editable_get_text(native));
}

SignalConnection Entry::on_changed(
        void (*action)(void *),
        void *data) {
    SignalConnection *slot;
    void *handler;
    void *userAction;

    gtk_use((Widget *)this);
    if (action == nullptr)
        gtk_fail("null");
    handler = handler_of(entry_changed);
    userAction = action_of(action);
    slot = gtk_bind(
            native,
            "changed",
            handler,
            userAction,
            data,
            0);
    gtk_keep((Widget *)this, slot);
    return *slot;
}

CheckButton::CheckButton(const char *label) : Widget() {
    gtk_check_text(label);
    native = gtk_sink(
            gtk_check_button_new_with_label(label));
}

void CheckButton::set_label(const char *label) {
    gtk_use((Widget *)this);
    gtk_check_text(label);
    gtk_check_button_set_label(native, label);
}

const char *CheckButton::label() const {
    gtk_use((Widget *)this);
    return gtk_text_or_empty(
            gtk_check_button_get_label(native));
}

void CheckButton::set_active(bool value) {
    gtk_use((Widget *)this);
    gtk_check_button_set_active(native, gtk_flag(value));
}

bool CheckButton::active() const {
    gtk_use((Widget *)this);
    return gtk_check_button_get_active(native) != 0;
}

SignalConnection CheckButton::on_toggled(
        void (*action)(void *, bool),
        void *data) {
    SignalConnection *slot;
    void (*typed)(void *, void *);
    void *handler;
    void (*user)(void *, bool);
    void *userAction;

    gtk_use((Widget *)this);
    if (action == nullptr)
        gtk_fail("null");
    typed = check_toggled;
    handler = (void *)typed;
    user = action;
    userAction = (void *)user;
    slot = gtk_bind(
            native,
            "toggled",
            handler,
            userAction,
            data,
            0);
    gtk_keep((Widget *)this, slot);
    return *slot;
}

ScrolledWindow::ScrolledWindow() : Widget() {
    kind = GTK_KIND_SCROLLED;
    native = gtk_sink(gtk_scrolled_window_new());
}

void ScrolledWindow::set_child(Widget *child) {
    gtk_check_child((Widget *)this, child);
    gtk_require_single((Widget *)this);
    gtk_scrolled_window_set_child(native, child->native);
    gtk_note_child((Widget *)this, child);
}

void ScrolledWindow::remove(Widget *child) {
    gtk_use((Widget *)this);
    if (child == nullptr)
        gtk_fail("null");
    if (child->parentWidget != (Widget *)this)
        gtk_fail("child");
    gtk_scrolled_window_set_child(native, nullptr);
    gtk_note_remove((Widget *)this, child);
}

void ScrolledWindow::set_min_content(
        long width,
        long height) {
    gtk_use((Widget *)this);
    if (width < 0 || height < 0)
        gtk_fail("range");
    gtk_scrolled_window_set_min_content_width(
            native,
            (int)width);
    gtk_scrolled_window_set_min_content_height(
            native,
            (int)height);
}

void ScrolledWindow::set_policy(
        int horizontal,
        int vertical) {
    gtk_use((Widget *)this);
    if (horizontal < GTK_POLICY_ALWAYS
            || horizontal > GTK_POLICY_EXTERNAL)
        gtk_fail("range");
    if (vertical < GTK_POLICY_ALWAYS
            || vertical > GTK_POLICY_EXTERNAL)
        gtk_fail("range");
    gtk_scrolled_window_set_policy(
            native,
            horizontal,
            vertical);
}

enum { GTK_PHASE_CAPTURE = 1 };
enum { GTK_SHORTCUT_MANAGED = 1 };

static int key_run(void *widget, void *args, void *data) {
    KeyHook *hook;
    void (*action)(void *);

    (void)widget;
    (void)args;
    hook = (KeyHook *)data;
    if (hook == nullptr || hook->action == nullptr)
        return 0;
    action = hook->action;
    action(hook->data);
    return 1;
}

void Widget::add_css(const char *css) {
    void *provider;
    void *context;

    gtk_use(this);
    gtk_check_text(css);
    provider = gtk_css_provider_new();
    if (provider == nullptr)
        gtk_fail("gtk");
    gtk_css_provider_load_from_string(provider, css);
    context = gtk_widget_get_style_context(native);
    if (context == nullptr)
        gtk_fail("gtk");
    gtk_style_context_add_provider(
            context,
            provider,
            600);
    g_object_unref(provider);
}

void Widget::add_shortcut(
        const char *accel,
        void (*action)(void *),
        void *data) {
    void *controller;
    void *trigger;
    void *callback;
    void *shortcut;
    KeyHook *hook;
    SignalConnection *kept;
    int (*typed)(void *, void *, void *);

    gtk_use(this);
    gtk_check_text(accel);
    if (action == nullptr)
        gtk_fail("null");
    controller = g_object_get_data(native, "smallcpp-keys");
    if (controller == nullptr) {
        controller = gtk_shortcut_controller_new();
        if (controller == nullptr)
            gtk_fail("gtk");
        gtk_event_controller_set_propagation_phase(
                controller,
                GTK_PHASE_CAPTURE);
        gtk_shortcut_controller_set_scope(
                controller,
                GTK_SHORTCUT_MANAGED);
        gtk_widget_add_controller(native, controller);
        g_object_set_data(
                native,
                "smallcpp-keys",
                controller);
    }
    trigger = gtk_shortcut_trigger_parse_string(accel);
    if (trigger == nullptr)
        gtk_fail("range");
    hook = new KeyHook();
    hook->action = action;
    hook->data = data;
    /* GTK holds the hook, and the collector does not
     * scan GTK. A slot on this widget keeps the hook
     * alive after add_shortcut returns. */
    kept = new SignalConnection();
    kept->data = (void *)hook;
    kept->live = 1;
    gtk_keep(this, kept);
    typed = key_run;
    callback = gtk_callback_action_new(
            (void *)typed,
            (void *)hook,
            nullptr);
    if (callback == nullptr)
        gtk_fail("gtk");
    shortcut = gtk_shortcut_new(trigger, callback);
    if (shortcut == nullptr)
        gtk_fail("gtk");
    gtk_shortcut_controller_add_shortcut(
            controller,
            shortcut);
}

void Widget::clear_shortcuts(void) {
    void *controller;

    gtk_use(this);
    controller = g_object_get_data(native, "smallcpp-keys");
    if (controller == nullptr)
        return;
    gtk_widget_remove_controller(native, controller);
    g_object_set_data(native, "smallcpp-keys", nullptr);
}

static int copy_chars(
        char *buf,
        long room,
        const char *text) {
    long n;
    long i;

    n = 0;
    while (text[n] != 0)
        n = n + 1;
    if (n + 1 > room)
        return 0;
    i = 0;
    while (i < n) {
        buf[i] = text[i];
        i = i + 1;
    }
    buf[n] = 0;
    return 1;
}

static int key_pressed(
        void *controller,
        unsigned key,
        unsigned code,
        unsigned state,
        void *data) {
    SignalConnection *slot;
    int (*action)(void *, const char *, int);
    unsigned mods;
    unsigned mask;
    char owned[128];
    char *name;
    int escape;
    int used;

    (void)controller;
    (void)code;
    slot = (SignalConnection *)data;
    action = (int (*)(void *, const char *, int))slot->action;
    if (slot->live == 0 || action == nullptr)
        return 0;
    mask = gtk_accelerator_get_default_mod_mask();
    mods = state & mask;
    escape = 0;
    if (key == 0xff1b && mods == 0)
        escape = 1;
    if (escape == 0 && gtk_accelerator_valid(key, mods) == 0)
        return 0;
    owned[0] = 0;
    if (escape == 0) {
        name = gtk_accelerator_name(key, mods);
        if (name == nullptr)
            return 0;
        if (copy_chars(owned, 128, name) == 0) {
            g_free((void *)name);
            return 0;
        }
        g_free((void *)name);
    }
    used = action(slot->data, owned, escape);
    if (used == 0)
        return 0;
    return 1;
}

int Widget::normalize_accel(
        const char *accel,
        char *buf,
        long room) {
    unsigned key;
    unsigned mods;
    char *name;

    gtk_use(this);
    if (buf == nullptr || room < 2)
        gtk_fail("range");
    buf[0] = 0;
    if (accel == nullptr || accel[0] == 0)
        return 1;
    key = 0;
    mods = 0;
    if (gtk_accelerator_parse(accel, &key, &mods) == 0)
        return 0;
    name = gtk_accelerator_name(key, mods);
    if (name == nullptr)
        return 0;
    if (copy_chars(buf, room, name) == 0) {
        g_free((void *)name);
        buf[0] = 0;
        return 0;
    }
    g_free((void *)name);
    return 1;
}

SignalConnection Widget::on_key(
        int (*action)(void *, const char *, int),
        void *data) {
    void *controller;
    SignalConnection *slot;
    int (*typed)(
            void *,
            unsigned,
            unsigned,
            unsigned,
            void *);
    void *handler;
    void *userAction;

    gtk_use(this);
    if (action == nullptr)
        gtk_fail("null");
    controller = gtk_event_controller_key_new();
    if (controller == nullptr)
        gtk_fail("gtk");
    gtk_event_controller_set_propagation_phase(controller, 1);
    gtk_widget_add_controller(native, controller);
    typed = key_pressed;
    handler = (void *)typed;
    userAction = (void *)action;
    slot = gtk_bind(
            controller,
            "key-pressed",
            handler,
            userAction,
            data,
            0);
    gtk_keep(this, slot);
    return *slot;
}

int Widget::shortcut_ok(const char *accel) {
    void *trigger;

    if (accel == nullptr || accel[0] == 0)
        return 0;
    trigger = gtk_shortcut_trigger_parse_string(accel);
    if (trigger == nullptr)
        return 0;
    g_object_unref(trigger);
    return 1;
}

}
