/* Text buffer, marks, and the text view.
 * TextIter is a line and a character offset.
 * It is not a live GTK iterator. */
#include <gtk.shpp>
#include <exceptions>
#include "gtk-native"
#include "gtk-globals"

namespace Gtk {

enum { GTK_TYPE_STRING = 64 };
enum { GTK_CONNECT_AFTER = 1 };

static void use_buffer(const TextBuffer *buffer) {
    gtk_check_thread();
    if (buffer == nullptr || buffer->native == nullptr)
        gtk_fail("disposed");
}

static void use_mark(const TextMark *mark) {
    gtk_check_thread();
    if (mark == nullptr || mark->native == nullptr)
        gtk_fail("disposed");
    if (mark->buffer == nullptr
            || mark->buffer->native == nullptr)
        gtk_fail("disposed");
}

static int iter_order(TextIter *start, TextIter *end) {
    if (start == nullptr || end == nullptr)
        gtk_fail("null");
    if (start->lineNumber > end->lineNumber)
        return 0;
    if (start->lineNumber == end->lineNumber
            && start->charOffset > end->charOffset)
        return 0;
    return 1;
}

static void buffer_changed(void *buffer, void *data) {
    SignalConnection *slot;
    void (*action)(void *);

    (void)buffer;
    slot = (SignalConnection *)data;
    action = (void (*)(void *))slot->action;
    if (slot->live != 0 && action != nullptr)
        action(slot->data);
}

static void view_moved(
        void *view,
        int step,
        int count,
        int extend,
        void *data) {
    SignalConnection *slot;
    TextView *text;
    TextBuffer *buffer;
    long words[12];
    void *iter;
    void *mark;
    void (*action)(void *, long, long);
    long line;
    long offset;

    (void)view;
    (void)step;
    (void)count;
    (void)extend;
    slot = (SignalConnection *)data;
    action = (void (*)(void *, long, long))slot->action;
    if (slot->live == 0 || action == nullptr)
        return;
    text = (TextView *)slot->owner;
    if (text == nullptr || text->buffer == nullptr)
        return;
    buffer = text->buffer;
    if (buffer->native == nullptr)
        return;
    gtk_clear_iter(words);
    iter = (void *)words;
    mark = gtk_text_buffer_get_insert(buffer->native);
    gtk_text_buffer_get_iter_at_mark(
            buffer->native,
            iter,
            mark);
    line = gtk_text_iter_get_line(iter);
    offset = gtk_text_iter_get_line_offset(iter);
    action(slot->data, line, offset);
}

static void read_mark(
        TextMark *mark,
        long *line,
        long *offset) {
    long words[12];
    void *iter;

    gtk_clear_iter(words);
    iter = (void *)words;
    gtk_text_buffer_get_iter_at_mark(
            mark->buffer->native,
            iter,
            mark->native);
    *line = gtk_text_iter_get_line(iter);
    *offset = gtk_text_iter_get_line_offset(iter);
}

TextIter::TextIter(long line, long offset) {
    lineNumber = line;
    charOffset = offset;
}

long TextIter::line() const {
    return lineNumber;
}

long TextIter::offset() const {
    return charOffset;
}

TextBuffer::TextBuffer() {
    gtk_check_thread();
    gtk_ensure();
    native = gtk_text_buffer_new(nullptr);
    if (native == nullptr)
        gtk_fail("gtk");
    gtk_text_buffer_set_enable_undo(native, 1);
    ownedText = nullptr;
    slots = nullptr;
    slotCount = 0;
    slotRoom = 0;
}

TextBuffer::~TextBuffer() {
    long i;

    if (ownedText != nullptr) {
        free((void *)ownedText);
        ownedText = nullptr;
    }
    if (native == nullptr)
        return;
    i = 0;
    while (i < slotCount) {
        if (slots[i] != nullptr && slots[i]->live != 0) {
            g_signal_handler_disconnect(
                    slots[i]->instance,
                    slots[i]->handler);
            slots[i]->live = 0;
            slots[i]->data = nullptr;
            slots[i]->action = nullptr;
        }
        i = i + 1;
    }
    g_object_unref(native);
    native = nullptr;
}

void TextBuffer::set_text(const char *text) {
    use_buffer(this);
    gtk_check_text(text);
    gtk_text_buffer_set_text(native, text, -1);
}

const char *TextBuffer::get_text() {
    long start[12];
    long end[12];
    void *first;
    void *second;
    char *raw;
    char *copy;

    use_buffer(this);
    gtk_clear_iter(start);
    gtk_clear_iter(end);
    first = (void *)start;
    second = (void *)end;
    gtk_text_buffer_get_bounds(native, first, second);
    raw = gtk_text_buffer_get_text(
            native,
            first,
            second,
            1);
    if (raw == nullptr)
        copy = gtk_copy("");
    else {
        copy = gtk_copy(raw);
        g_free((void *)raw);
    }
    if (ownedText != nullptr)
        free((void *)ownedText);
    ownedText = copy;
    return ownedText;
}

void TextBuffer::insert(TextIter *at, const char *text) {
    long words[12];

    use_buffer(this);
    if (at == nullptr)
        gtk_fail("null");
    gtk_check_text(text);
    gtk_place(
            native,
            words,
            at->lineNumber,
            at->charOffset);
    gtk_text_buffer_insert(
            native,
            (void *)words,
            text,
            -1);
}

void TextBuffer::delete_range(
        TextIter *start,
        TextIter *end) {
    long first[12];
    long second[12];

    use_buffer(this);
    if (iter_order(start, end) == 0)
        gtk_fail("range");
    gtk_place(
            native,
            first,
            start->lineNumber,
            start->charOffset);
    gtk_place(
            native,
            second,
            end->lineNumber,
            end->charOffset);
    gtk_text_buffer_delete(
            native,
            (void *)first,
            (void *)second);
}

void TextBuffer::place_cursor(TextIter *at) {
    long words[12];

    use_buffer(this);
    if (at == nullptr)
        gtk_fail("null");
    gtk_place(
            native,
            words,
            at->lineNumber,
            at->charOffset);
    gtk_text_buffer_place_cursor(native, (void *)words);
}

void TextBuffer::select_range(
        TextIter *start,
        TextIter *end) {
    long first[12];
    long second[12];

    use_buffer(this);
    if (iter_order(start, end) == 0)
        gtk_fail("range");
    gtk_place(
            native,
            first,
            start->lineNumber,
            start->charOffset);
    gtk_place(
            native,
            second,
            end->lineNumber,
            end->charOffset);
    gtk_text_buffer_select_range(
            native,
            (void *)first,
            (void *)second);
}

bool TextBuffer::selection_bounds(
        TextIter *start,
        TextIter *end) {
    long first[12];
    long second[12];
    void *a;
    void *b;
    int selected;

    use_buffer(this);
    if (start == nullptr || end == nullptr)
        gtk_fail("null");
    gtk_clear_iter(first);
    gtk_clear_iter(second);
    a = (void *)first;
    b = (void *)second;
    selected = gtk_text_buffer_get_selection_bounds(
            native,
            a,
            b);
    start->lineNumber = gtk_text_iter_get_line(a);
    start->charOffset = gtk_text_iter_get_line_offset(a);
    end->lineNumber = gtk_text_iter_get_line(b);
    end->charOffset = gtk_text_iter_get_line_offset(b);
    return selected != 0;
}

void TextBuffer::create_tag(
        const char *name,
        const char *foreground) {
    long words[4];
    void *value;
    void *tag;
    void *table;
    int ok;
    long i;

    use_buffer(this);
    gtk_check_text(name);
    gtk_check_text(foreground);
    i = 0;
    while (i < 4) {
        words[i] = 0;
        i = i + 1;
    }
    value = (void *)words;
    g_value_init(value, GTK_TYPE_STRING);
    g_value_set_string(value, foreground);
    tag = gtk_text_tag_new(name);
    if (tag == nullptr)
        gtk_fail("gtk");
    g_object_set_property(tag, "foreground", value);
    table = gtk_text_buffer_get_tag_table(native);
    ok = gtk_text_tag_table_add(table, tag);
    g_object_unref(tag);
    g_value_unset(value);
    if (ok == 0)
        gtk_fail("gtk");
}

void TextBuffer::set_tag_background(
        const char *name,
        const char *color) {
    long words[4];
    void *value;
    void *tag;
    void *table;
    int ok;
    long i;

    use_buffer(this);
    gtk_check_text(name);
    gtk_check_text(color);
    table = gtk_text_buffer_get_tag_table(native);
    if (table == nullptr)
        gtk_fail("gtk");
    tag = gtk_text_tag_table_lookup(table, name);
    if (tag == nullptr) {
        tag = gtk_text_tag_new(name);
        if (tag == nullptr)
            gtk_fail("gtk");
        ok = gtk_text_tag_table_add(table, tag);
        g_object_unref(tag);
        if (ok == 0)
            gtk_fail("gtk");
        tag = gtk_text_tag_table_lookup(table, name);
        if (tag == nullptr)
            gtk_fail("gtk");
    }
    i = 0;
    while (i < 4) {
        words[i] = 0;
        i = i + 1;
    }
    value = (void *)words;
    g_value_init(value, GTK_TYPE_STRING);
    g_value_set_string(value, color);
    g_object_set_property(
            tag,
            "paragraph-background",
            value);
    g_value_unset(value);
}

void TextBuffer::apply_tag(
        const char *name,
        TextIter *start,
        TextIter *end) {
    void *table;
    void *tag;
    long first[12];
    long second[12];

    use_buffer(this);
    gtk_check_text(name);
    if (iter_order(start, end) == 0)
        gtk_fail("range");
    table = gtk_text_buffer_get_tag_table(native);
    tag = gtk_text_tag_table_lookup(table, name);
    if (tag == nullptr)
        gtk_fail("gtk");
    gtk_place(
            native,
            first,
            start->lineNumber,
            start->charOffset);
    gtk_place(
            native,
            second,
            end->lineNumber,
            end->charOffset);
    gtk_text_buffer_apply_tag(
            native,
            tag,
            (void *)first,
            (void *)second);
}

void TextBuffer::remove_tag(
        const char *name,
        TextIter *start,
        TextIter *end) {
    void *table;
    void *tag;
    long first[12];
    long second[12];

    use_buffer(this);
    gtk_check_text(name);
    if (iter_order(start, end) == 0)
        gtk_fail("range");
    table = gtk_text_buffer_get_tag_table(native);
    tag = gtk_text_tag_table_lookup(table, name);
    if (tag == nullptr)
        gtk_fail("gtk");
    gtk_place(
            native,
            first,
            start->lineNumber,
            start->charOffset);
    gtk_place(
            native,
            second,
            end->lineNumber,
            end->charOffset);
    gtk_text_buffer_remove_tag(
            native,
            tag,
            (void *)first,
            (void *)second);
}

void TextBuffer::undo() {
    use_buffer(this);
    gtk_text_buffer_undo(native);
}

void TextBuffer::redo() {
    use_buffer(this);
    gtk_text_buffer_redo(native);
}

SignalConnection TextBuffer::on_changed(
        void (*action)(void *),
        void *data) {
    SignalConnection *slot;
    void (*typed)(void *, void *);
    void *handler;
    void *userAction;

    use_buffer(this);
    if (action == nullptr)
        gtk_fail("null");
    typed = buffer_changed;
    handler = (void *)typed;
    userAction = (void *)action;
    slot = gtk_bind(
            native,
            "changed",
            handler,
            userAction,
            data,
            0);
    gtk_keep_buffer(this, slot);
    return *slot;
}

TextMark *TextBuffer::create_mark(
        const char *name,
        long line,
        long offset) {
    use_buffer(this);
    return new TextMark(this, name, line, offset);
}

TextMark::TextMark(
        TextBuffer *buffer,
        const char *name,
        long line,
        long offset) {
    long words[12];

    gtk_check_thread();
    if (buffer == nullptr)
        gtk_fail("null");
    if (buffer->native == nullptr)
        gtk_fail("disposed");
    gtk_check_text(name);
    this->buffer = buffer;
    ownedName = gtk_copy(name);
    gtk_place(buffer->native, words, line, offset);
    native = gtk_text_buffer_create_mark(
            buffer->native,
            ownedName,
            (void *)words,
            0);
    if (native == nullptr)
        gtk_fail("gtk");
}

TextMark::~TextMark() {
    native = nullptr;
    buffer = nullptr;
}

const char *TextMark::name() const {
    use_mark((TextMark *)this);
    if (ownedName == nullptr)
        return "";
    return ownedName;
}

void TextMark::move(long line, long offset) {
    long words[12];

    use_mark(this);
    gtk_place(buffer->native, words, line, offset);
    gtk_text_buffer_move_mark(
            buffer->native,
            native,
            (void *)words);
}

long TextMark::line() const {
    long line;
    long offset;

    use_mark((TextMark *)this);
    read_mark((TextMark *)this, &line, &offset);
    return line;
}

long TextMark::offset() const {
    long line;
    long offset;

    use_mark((TextMark *)this);
    read_mark((TextMark *)this, &line, &offset);
    return offset;
}

TextView::TextView(TextBuffer *buffer) : Widget() {
    if (buffer == nullptr)
        gtk_fail("null");
    if (buffer->native == nullptr)
        gtk_fail("disposed");
    this->buffer = buffer;
    showNumbers = 0;
    numberHook = 0;
    columnMark = nullptr;
    numberArea = nullptr;
    numberAdjust = nullptr;
    numberChars[0] = 0;
    native = gtk_sink(
            gtk_text_view_new_with_buffer(buffer->native));
}

void TextView::set_editable(bool value) {
    gtk_use((Widget *)this);
    gtk_text_view_set_editable(native, gtk_flag(value));
}

bool TextView::editable() const {
    gtk_use((Widget *)this);
    return gtk_text_view_get_editable(native) != 0;
}

void TextView::set_monospace(bool value) {
    gtk_use((Widget *)this);
    gtk_text_view_set_monospace(native, gtk_flag(value));
}

bool TextView::monospace() const {
    gtk_use((Widget *)this);
    return gtk_text_view_get_monospace(native) != 0;
}

static int char_pixels(void *widget);
static int line_box(void *widget);

enum { GTK_TEXT_WINDOW_LEFT = 3 };
enum { GTK_NUMBER_CAP = 80 };
enum { PANGO_ALIGN_RIGHT = 2 };
enum { PANGO_SCALE = 1024 };

static void append_number(
        char *text,
        long cap,
        long *used,
        long num) {
    char digits[8];
    long n;
    long value;

    n = 0;
    value = num;
    if (value <= 0) {
        digits[0] = '0';
        n = 1;
    }
    while (value > 0 && n < 8) {
        digits[n] = (char)('0' + (int)(value % 10));
        n = n + 1;
        value = value / 10;
    }
    while (n > 0) {
        n = n - 1;
        if (*used + 1 >= cap)
            return;
        text[*used] = digits[n];
        *used = *used + 1;
    }
    if (*used + 1 >= cap)
        return;
    text[*used] = '\n';
    *used = *used + 1;
}

static void write_number(
        char *dest,
        long cap,
        long num) {
    long used;

    used = 0;
    dest[0] = 0;
    append_number(dest, cap, &used, num);
    if (used > 0 && dest[used - 1] == '\n')
        used = used - 1;
    dest[used] = 0;
}

static int digit_width(long lines) {
    long width;
    long probe;

    width = 1;
    probe = 9;
    while (probe < lines && width < 6) {
        width = width + 1;
        probe = probe * 10 + 9;
    }
    return (int)width;
}

static void fill_unmapped(TextView *view, long lines) {
    long count;
    long i;
    long used;

    count = lines;
    if (count > GTK_NUMBER_CAP)
        count = GTK_NUMBER_CAP;
    if (count < 1)
        count = 1;
    used = 0;
    view->numberChars[0] = 0;
    i = 0;
    while (i < count) {
        append_number(
                view->numberChars,
                512,
                &used,
                i + 1);
        i = i + 1;
    }
    view->numberChars[used] = 0;
}

static void place_numbers(TextView *view, void *cr, int width) {
    int rect[4];
    long words[12];
    long lines;
    long used;
    int top;
    int height;
    int guard;
    int pixels;
    int lineHeight;
    int placed;
    int nextTop;

    if (view == nullptr || view->showNumbers == 0)
        return;
    if (view->buffer == nullptr
            || view->buffer->native == nullptr)
        return;
    lines = gtk_text_buffer_get_line_count(
            view->buffer->native);
    if (lines < 1)
        lines = 1;
    pixels = char_pixels(view->native);
    if (pixels < 1)
        pixels = 8;
    lineHeight = line_box(view->native);
    placed = 0;
    nextTop = 0;
    if (view->numberArea != nullptr) {
        int request;

        request = digit_width(lines);
        if (request < 4)
            request = 4;
        request = pixels * request + pixels;
        gtk_widget_set_size_request(
                view->numberArea,
                request,
                -1);
    }
    if (gtk_widget_get_mapped(view->native) == 0) {
        fill_unmapped(view, lines);
        return;
    }
    rect[0] = 0;
    rect[1] = 0;
    rect[2] = 0;
    rect[3] = 0;
    gtk_text_view_get_visible_rect(
            view->native,
            (void *)rect);
    if (rect[3] <= 0) {
        fill_unmapped(view, lines);
        return;
    }
    gtk_clear_iter(words);
    gtk_text_view_get_line_at_y(
            view->native,
            (void *)words,
            rect[1],
            nullptr);
    used = 0;
    view->numberChars[0] = 0;
    guard = 0;
    while (guard < GTK_NUMBER_CAP) {
        long line;
        int drawY;
        char label[16];

        top = 0;
        height = 0;
        gtk_text_view_get_line_yrange(
                view->native,
                (void *)words,
                &top,
                &height);
        if (height < 1) {
            height = lineHeight;
            if (placed != 0 && top < nextTop)
                top = nextTop;
        }
        line = gtk_text_iter_get_line((void *)words);
        drawY = top - rect[1];
        if (drawY > rect[3])
            break;
        if (drawY + height >= 0) {
            append_number(
                    view->numberChars,
                    512,
                    &used,
                    line + 1);
            if (cr != nullptr && width > 0) {
                void *layout;
                float color[4];

                write_number(label, 16, line + 1);
                layout = gtk_widget_create_pango_layout(
                        view->numberArea,
                        label);
                if (layout != nullptr) {
                    int box;

                    box = width - pixels;
                    if (box < 1)
                        box = width;
                    pango_layout_set_width(
                            layout,
                            box * PANGO_SCALE);
                    pango_layout_set_alignment(
                            layout,
                            PANGO_ALIGN_RIGHT);
                    gtk_widget_get_color(
                            view->numberArea,
                            color);
                    cairo_set_source_rgba(
                            cr,
                            (double)color[0],
                            (double)color[1],
                            (double)color[2],
                            (double)color[3]);
                    cairo_move_to(cr, 0, (double)drawY);
                    pango_cairo_show_layout(cr, layout);
                    g_object_unref(layout);
                }
            }
        }
        nextTop = top + height;
        placed = 1;
        if (gtk_text_iter_forward_line((void *)words) == 0)
            break;
        guard = guard + 1;
    }
    view->numberChars[used] = 0;
}

static void draw_numbers(
        void *area,
        void *cr,
        int width,
        int height,
        void *data) {
    (void)area;
    (void)height;
    place_numbers((TextView *)data, cr, width);
}

static void paint_numbers(TextView *view) {
    place_numbers(view, nullptr, 0);
    if (view != nullptr && view->numberArea != nullptr)
        gtk_widget_queue_draw(view->numberArea);
}

static void numbers_changed(void *data) {
    paint_numbers((TextView *)data);
}

static void numbers_moved(void *adjust, void *data);

static void watch_scroll(TextView *view) {
    void *adjust;
    void (*typed)(void *, void *);

    if (view == nullptr)
        return;
    adjust = gtk_scrollable_get_vadjustment(view->native);
    if (adjust == nullptr || adjust == view->numberAdjust)
        return;
    view->numberAdjust = adjust;
    typed = numbers_moved;
    g_signal_connect_data(
            adjust,
            "value-changed",
            (void *)typed,
            (void *)view,
            nullptr,
            0);
}

static void numbers_moved(void *adjust, void *data) {
    (void)adjust;
    paint_numbers((TextView *)data);
}

static void numbers_adjust(
        void *widget,
        void *pspec,
        void *data) {
    (void)widget;
    (void)pspec;
    watch_scroll((TextView *)data);
    paint_numbers((TextView *)data);
}

static void numbers_mapped(void *widget, void *data) {
    (void)widget;
    watch_scroll((TextView *)data);
    paint_numbers((TextView *)data);
}

void TextView::scroll_to(long line, long offset) {
    long words[12];
    void *mark;

    gtk_use((Widget *)this);
    if (buffer == nullptr || buffer->native == nullptr)
        gtk_fail("disposed");
    gtk_place(buffer->native, words, line, offset);
    mark = gtk_text_buffer_get_mark(
            buffer->native,
            "smallcpp-scroll");
    if (mark == nullptr) {
        mark = gtk_text_buffer_create_mark(
                buffer->native,
                "smallcpp-scroll",
                (void *)words,
                1);
    } else {
        gtk_text_buffer_move_mark(
                buffer->native,
                mark,
                (void *)words);
    }
    if (mark == nullptr)
        gtk_fail("gtk");
    gtk_text_view_scroll_to_mark(
            native,
            mark,
            0.0,
            0,
            0.0,
            0.0);
}

void TextView::set_line_numbers(bool value) {
    void (*typed)(void *, void *);

    gtk_use((Widget *)this);
    if (value == false) {
        showNumbers = 0;
        gtk_text_view_set_gutter(
                native,
                GTK_TEXT_WINDOW_LEFT,
                nullptr);
        return;
    }
    showNumbers = 1;
    if (numberArea == nullptr) {
        void (*draw)(void *, void *, int, int, void *);

        numberArea = gtk_drawing_area_new();
        if (numberArea == nullptr)
            gtk_fail("gtk");
        gtk_widget_add_css_class(numberArea, "monospace");
        draw = draw_numbers;
        gtk_drawing_area_set_draw_func(
                numberArea,
                (void *)draw,
                (void *)this,
                nullptr);
    }
    gtk_text_view_set_gutter(
            native,
            GTK_TEXT_WINDOW_LEFT,
            numberArea);
    if (numberHook == 0 && buffer != nullptr) {
        void (*notify)(void *, void *, void *);

        buffer->on_changed(numbers_changed, (void *)this);
        notify = numbers_adjust;
        g_signal_connect_data(
                native,
                "notify::vadjustment",
                (void *)notify,
                (void *)this,
                nullptr,
                0);
        typed = numbers_mapped;
        g_signal_connect_data(
                native,
                "map",
                (void *)typed,
                (void *)this,
                nullptr,
                0);
        watch_scroll(this);
        numberHook = 1;
    }
    paint_numbers(this);
}

bool TextView::line_numbers() const {
    gtk_use((Widget *)this);
    return showNumbers != 0;
}

const char *TextView::line_number_text() {
    gtk_use((Widget *)this);
    if (showNumbers == 0)
        return "";
    place_numbers(this, nullptr, 0);
    return numberChars;
}

long TextView::line_number_origin(long line) const {
    int rect[4];
    long words[12];
    long lines;
    int top;
    int height;

    gtk_use((Widget *)this);
    if (showNumbers == 0 || buffer == nullptr)
        return -1;
    if (buffer->native == nullptr)
        return -1;
    if (gtk_widget_get_mapped(native) == 0)
        return -1;
    rect[0] = 0;
    rect[1] = 0;
    rect[2] = 0;
    rect[3] = 0;
    gtk_text_view_get_visible_rect(native, (void *)rect);
    if (rect[3] <= 0)
        return -1;
    lines = gtk_text_buffer_get_line_count(buffer->native);
    if (lines < 1)
        lines = 1;
    if (line < 0 || line >= lines)
        return -1;
    gtk_clear_iter(words);
    gtk_text_buffer_get_iter_at_line(
            buffer->native,
            (void *)words,
            (int)line);
    top = 0;
    height = 0;
    gtk_text_view_get_line_yrange(
            native,
            (void *)words,
            &top,
            &height);
    return (long)(top - rect[1]);
}

SignalConnection TextView::on_move_cursor(
        void (*action)(void *, long, long),
        void *data) {
    SignalConnection *slot;
    void (*typed)(void *, int, int, int, void *);
    void *handler;
    void (*user)(void *, long, long);
    void *userAction;

    gtk_use((Widget *)this);
    if (action == nullptr)
        gtk_fail("null");
    typed = view_moved;
    handler = (void *)typed;
    user = action;
    userAction = (void *)user;
    slot = gtk_bind(
            native,
            "move-cursor",
            handler,
            userAction,
            data,
            GTK_CONNECT_AFTER);
    gtk_keep((Widget *)this, slot);
    return *slot;
}

static void add_chars(
        char *dest,
        long room,
        long *used,
        const char *src) {
    long i;

    i = 0;
    while (src[i] != 0 && *used + 1 < room) {
        dest[*used] = src[i];
        *used = *used + 1;
        i = i + 1;
    }
    dest[*used] = 0;
}

static void copy_span(
        char *dest,
        long room,
        const char *src,
        long from,
        long to) {
    long used;

    used = 0;
    if (dest == nullptr || room < 2)
        return;
    dest[0] = 0;
    while (from < to) {
        char bit[2];

        bit[0] = src[from];
        if (bit[0] == '"' || bit[0] == '\\'
                || bit[0] == '{' || bit[0] == '}')
            bit[0] = ' ';
        bit[1] = 0;
        add_chars(dest, room, &used, bit);
        from = from + 1;
    }
}

static void split_font(
        const char *desc,
        char *family,
        long room,
        char *size,
        long sroom) {
    long n;
    long i;
    long start;
    long cut;
    long used;

    n = 0;
    while (desc[n] != 0)
        n = n + 1;
    while (n > 0 && desc[n - 1] == ' ')
        n = n - 1;
    start = n;
    while (start > 0 && desc[start - 1] != ' ')
        start = start - 1;
    size[0] = '1';
    size[1] = '2';
    size[2] = 0;
    cut = n;
    if (start > 0 && start < n
            && desc[start] >= '0'
            && desc[start] <= '9') {
        used = 0;
        i = start;
        size[0] = 0;
        while (i < n && used + 1 < sroom) {
            int digit;

            digit = 0;
            if (desc[i] >= '0' && desc[i] <= '9')
                digit = 1;
            if (desc[i] == '.' && used > 0)
                digit = 1;
            if (digit == 0)
                break;
            size[used] = desc[i];
            used = used + 1;
            size[used] = 0;
            i = i + 1;
        }
        if (size[0] == 0) {
            size[0] = '1';
            size[1] = '2';
            size[2] = 0;
        }
        cut = start;
        while (cut > 0 && desc[cut - 1] == ' ')
            cut = cut - 1;
    }
    if (cut <= 0)
        copy_span(family, room, "Monospace", 0, 9);
    else
        copy_span(family, room, desc, 0, cut);
}

static int line_box(void *widget) {
    void *layout;
    int width;
    int height;

    width = 0;
    height = 0;
    layout = gtk_widget_create_pango_layout(widget, "0");
    if (layout == nullptr)
        return 16;
    pango_layout_get_pixel_size(layout, &width, &height);
    g_object_unref(layout);
    if (height < 1)
        return 16;
    return height;
}

static int char_pixels(void *widget) {
    void *layout;
    int width;
    int height;
    int pixels;

    width = 0;
    height = 0;
    layout = gtk_widget_create_pango_layout(
            widget,
            "0000000000");
    if (layout == nullptr)
        return 8;
    pango_layout_get_pixel_size(
            layout,
            &width,
            &height);
    g_object_unref(layout);
    if (width < 10)
        return 8;
    pixels = width / 10;
    if (pixels < 1)
        return 8;
    return pixels;
}

void TextView::set_font(const char *description) {
    char family[128];
    char size[16];
    char css[320];
    long used;

    gtk_use((Widget *)this);
    gtk_check_text(description);
    split_font(description, family, 128, size, 16);
    used = 0;
    css[0] = 0;
    add_chars(css, 320, &used, "textview, text { font-family: \"");
    add_chars(css, 320, &used, family);
    add_chars(css, 320, &used, "\"; font-size: ");
    add_chars(css, 320, &used, size);
    add_chars(css, 320, &used, "pt; }");
    add_css(css);
    if (numberArea != nullptr) {
        void *provider;
        void *context;

        used = 0;
        css[0] = 0;
        add_chars(css, 320, &used, "* { font-family: \"");
        add_chars(css, 320, &used, family);
        add_chars(css, 320, &used, "\"; font-size: ");
        add_chars(css, 320, &used, size);
        add_chars(css, 320, &used, "pt; }");
        provider = gtk_css_provider_new();
        gtk_css_provider_load_from_string(provider, css);
        context = gtk_widget_get_style_context(numberArea);
        gtk_style_context_add_provider(
                context,
                provider,
                600);
        g_object_unref(provider);
    }
}

void TextView::set_line_shade(int on, const char *color) {
    gtk_use((Widget *)this);
    if (color == nullptr)
        color = "";
    smallcpp_text_line_shade(native, on, color);
}

void TextView::set_marks(
        int spaces,
        int ends,
        int stops,
        int tabWidth) {
    gtk_use((Widget *)this);
    smallcpp_text_marks(
            native,
            spaces,
            ends,
            stops,
            tabWidth);
}

void TextView::set_tab_width(int columns) {
    void *tabs;
    int pixels;
    int i;
    int pos;

    gtk_use((Widget *)this);
    if (columns < 1)
        columns = 1;
    if (columns > 32)
        columns = 32;
    pixels = char_pixels(native);
    if (pixels < 1)
        pixels = 8;
    tabs = pango_tab_array_new(32, 1);
    if (tabs == nullptr)
        gtk_fail("gtk");
    i = 0;
    pos = pixels * columns;
    while (i < 32) {
        pango_tab_array_set_tab(tabs, i, 0, pos);
        i = i + 1;
        pos = pos + pixels * columns;
    }
    gtk_text_view_set_tabs(native, tabs);
    pango_tab_array_free(tabs);
}

void TextView::set_column_marker(
        long column,
        const char *color) {
    char safe[40];
    char css[160];
    long i;
    long used;
    int x;
    int pixels;

    gtk_use((Widget *)this);
    if (column < 1 || color == nullptr || color[0] == 0) {
        if (columnMark != nullptr) {
            if (gtk_widget_get_parent(
                        columnMark->native) == native)
                gtk_text_view_remove(
                        native,
                        columnMark->native);
            columnMark = nullptr;
        }
        return;
    }
    i = 0;
    while (color[i] != 0 && i + 1 < 40) {
        char ch;

        ch = color[i];
        if ((ch >= 'a' && ch <= 'z')
                || (ch >= 'A' && ch <= 'Z')
                || (ch >= '0' && ch <= '9')
                || ch == '#')
            safe[i] = ch;
        else
            break;
        i = i + 1;
    }
    safe[i] = 0;
    if (safe[0] == 0)
        return;
    pixels = char_pixels(native);
    x = gtk_text_view_get_left_margin(native);
    x = x + (int)column * pixels;
    if (columnMark == nullptr) {
        columnMark = (Widget *)new Label("");
        gtk_text_view_add_overlay(
                native,
                columnMark->native,
                x,
                0);
    } else
        gtk_text_view_move_overlay(
                native,
                columnMark->native,
                x,
                0);
    gtk_widget_set_size_request(
            columnMark->native,
            2,
            100000);
    used = 0;
    css[0] = 0;
    add_chars(
            css,
            160,
            &used,
            "* { min-width: 2px; padding: 0; ");
    add_chars(css, 160, &used, "margin: 0; background-color: ");
    add_chars(css, 160, &used, safe);
    add_chars(css, 160, &used, "; }");
    columnMark->add_css(css);
}

}
