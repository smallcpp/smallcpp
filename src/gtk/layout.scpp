/* Header bars, menus, popovers, panes,
 * notebooks, and column views. */
#include <gtk.shpp>
#include "layout.shpp"
#include <exceptions>
#include "gtk-native"
#include "gtk-globals"

namespace Gtk {

static void write_index(char *buf, long index) {
    char digits[24];
    long n;
    long i;
    long j;

    buf[0] = 'n';
    if (index <= 0) {
        buf[1] = '0';
        buf[2] = 0;
        return;
    }
    n = index;
    i = 0;
    while (n > 0 && i < 20) {
        digits[i] = (char)('0' + (n % 10));
        n = n / 10;
        i = i + 1;
    }
    j = 0;
    while (i > 0) {
        i = i - 1;
        buf[1 + j] = digits[i];
        j = j + 1;
    }
    buf[1 + j] = 0;
}

static void write_detailed(char *buf, long index) {
    char name[24];
    long i;

    write_index(name, index);
    buf[0] = 'm';
    buf[1] = 'e';
    buf[2] = 'n';
    buf[3] = 'u';
    buf[4] = '.';
    i = 0;
    while (name[i] != 0) {
        buf[5 + i] = name[i];
        i = i + 1;
    }
    buf[5 + i] = 0;
}

static void menu_activate(
        void *action,
        void *parameter,
        void *data) {
    MenuPick *pick;

    (void)action;
    (void)parameter;
    pick = (MenuPick *)data;
    if (pick == nullptr || pick->button == nullptr)
        return;
    if (pick->button->menuAction == nullptr)
        return;
    pick->button->menuAction(
            pick->button->menuData,
            pick->label);
}

static void menu_cleanup(Widget *widget) {
    MenuButton *button;

    button = (MenuButton *)widget;
    if (button->menuModel != nullptr) {
        g_object_unref(button->menuModel);
        button->menuModel = nullptr;
    }
    if (button->actionGroup != nullptr) {
        g_object_unref(button->actionGroup);
        button->actionGroup = nullptr;
    }
}

static void notebook_switch(
        void *notebook,
        void *page,
        unsigned index,
        void *data) {
    SignalConnection *slot;
    void (*action)(void *, long);

    (void)notebook;
    (void)page;
    slot = (SignalConnection *)data;
    action = (void (*)(void *, long))slot->action;
    if (slot->live != 0 && action != nullptr)
        action(slot->data, (long)index);
}

static void column_setup(
        void *factory,
        void *item,
        void *data) {
    void *label;

    (void)factory;
    (void)data;
    label = gtk_label_new("");
    gtk_list_item_set_child(item, label);
}

static void column_bind(
        void *factory,
        void *item,
        void *data) {
    ColumnSlot *slot;
    unsigned position;
    void *child;
    const char *text;

    (void)factory;
    slot = (ColumnSlot *)data;
    child = gtk_list_item_get_child(item);
    text = "";
    if (slot != nullptr && slot->view != nullptr) {
        position = gtk_list_item_get_position(item);
        if ((long)position < slot->view->rowCount
                && slot->column < slot->view->columnCount
                && slot->column >= 0)
            text = slot->view->cell(
                    (long)position,
                    slot->column);
    }
    if (child != nullptr && text != nullptr)
        gtk_label_set_text(child, text);
}

static void column_activate(
        void *view,
        unsigned position,
        void *data) {
    SignalConnection *slot;
    void (*action)(void *, long);

    (void)view;
    slot = (SignalConnection *)data;
    action = (void (*)(void *, long))slot->action;
    if (slot->live != 0 && action != nullptr)
        action(slot->data, (long)position);
}

HeaderBar::HeaderBar() : Widget() {
    native = gtk_sink(gtk_header_bar_new());
    titleLabel = nullptr;
}

void HeaderBar::set_title(const char *title) {
    void *label;

    gtk_use((Widget *)this);
    gtk_check_text(title);
    label = gtk_label_new(title);
    gtk_header_bar_set_title_widget(native, label);
    titleLabel = label;
}

const char *HeaderBar::title() const {
    void *label;

    gtk_use((Widget *)this);
    label = gtk_header_bar_get_title_widget(native);
    if (label == nullptr)
        return "";
    return gtk_text_or_empty(gtk_label_get_text(label));
}

void HeaderBar::set_show_title_buttons(bool value) {
    gtk_use((Widget *)this);
    gtk_header_bar_set_show_title_buttons(
            native,
            gtk_flag(value));
}

bool HeaderBar::show_title_buttons() const {
    gtk_use((Widget *)this);
    return gtk_header_bar_get_show_title_buttons(
            native) != 0;
}

void HeaderBar::pack_start(Widget *child) {
    gtk_check_child((Widget *)this, child);
    gtk_header_bar_pack_start(native, child->native);
    gtk_note_child((Widget *)this, child);
}

void HeaderBar::pack_end(Widget *child) {
    gtk_check_child((Widget *)this, child);
    gtk_header_bar_pack_end(native, child->native);
    gtk_note_child((Widget *)this, child);
}

MenuButton::MenuButton(const char *label) : Widget() {
    void (*fn)(Widget *);

    gtk_check_text(label);
    native = gtk_sink(gtk_menu_button_new());
    gtk_menu_button_set_label(native, label);
    menuAction = nullptr;
    menuData = nullptr;
    menuModel = nullptr;
    actionGroup = nullptr;
    menuLabels = nullptr;
    menuCount = 0;
    menuPicks = nullptr;
    fn = menu_cleanup;
    cleanup = fn;
}

void MenuButton::set_label(const char *label) {
    gtk_use((Widget *)this);
    gtk_check_text(label);
    gtk_menu_button_set_label(native, label);
}

const char *MenuButton::label() const {
    gtk_use((Widget *)this);
    return gtk_text_or_empty(
            gtk_menu_button_get_label(native));
}

static void show_mnemonic(
        char *dest,
        long cap,
        const char *src) {
    long i;
    long j;

    i = 0;
    j = 0;
    dest[0] = 0;
    if (src == nullptr || cap < 2)
        return;
    while (src[i] != 0 && j + 2 < cap) {
        dest[j] = src[i];
        j = j + 1;
        if (src[i] == '_') {
            dest[j] = '_';
            j = j + 1;
        }
        i = i + 1;
    }
    dest[j] = 0;
}

void MenuButton::set_menu(
        const char **labels,
        long count,
        void (*action)(void *, const char *),
        void *data) {
    void *model;
    void *group;
    long i;
    char name[24];
    char detailed[32];
    void (*typed)(void *, void *, void *);
    void *handler;

    gtk_use((Widget *)this);
    if (action == nullptr)
        gtk_fail("null");
    if (count < 0)
        gtk_fail("range");
    if (count > 0 && labels == nullptr)
        gtk_fail("null");
    i = 0;
    while (i < count) {
        gtk_check_text(labels[i]);
        i = i + 1;
    }
    model = g_menu_new();
    group = g_simple_action_group_new();
    if (model == nullptr || group == nullptr)
        gtk_fail("gtk");
    menuLabels = new char *[count];
    menuPicks = new void *[count];
    menuCount = count;
    menuAction = action;
    menuData = data;
    typed = menu_activate;
    handler = (void *)typed;
    i = 0;
    while (i < count) {
        MenuPick *pick;
        void *simple;
        void *pickPtr;
        unsigned long id;

        menuLabels[i] = gtk_copy(labels[i]);
        pick = new MenuPick();
        pick->button = this;
        pick->label = menuLabels[i];
        menuPicks[i] = pick;
        write_index(name, i);
        write_detailed(detailed, i);
        simple = g_simple_action_new(name, nullptr);
        if (simple == nullptr)
            gtk_fail("gtk");
        pickPtr = (void *)pick;
        id = g_signal_connect_data(
                simple,
                "activate",
                handler,
                pickPtr,
                nullptr,
                0);
        if (id == 0)
            gtk_fail("gtk");
        g_action_map_add_action(group, simple);
        g_object_unref(simple);
        {
            char shown[192];

            show_mnemonic(shown, 192, labels[i]);
            g_menu_append(model, shown, detailed);
        }
        i = i + 1;
    }
    if (menuModel != nullptr)
        g_object_unref(menuModel);
    if (actionGroup != nullptr)
        g_object_unref(actionGroup);
    menuModel = model;
    actionGroup = group;
    gtk_widget_insert_action_group(
            native,
            "menu",
            group);
    gtk_menu_button_set_menu_model(native, model);
}

MenuSlot::MenuSlot() {
    long i;

    submenu = nullptr;
    action = nullptr;
    data = nullptr;
    labels = nullptr;
    picks = nullptr;
    count = 0;
    i = 0;
    while (i < 64) {
        accelText[i] = nullptr;
        checkOn[i] = 0;
        i = i + 1;
    }
}

static void write_slot(char *buf, long menu, long item) {
    buf[0] = 'm';
    buf[1] = (char)('0' + (int)menu);
    buf[2] = 'i';
    if (item < 10) {
        buf[3] = (char)('0' + (int)item);
        buf[4] = 0;
        return;
    }
    buf[3] = (char)('0' + (int)(item / 10));
    buf[4] = (char)('0' + (int)(item % 10));
    buf[5] = 0;
}

static void write_bar_detailed(
        char *buf,
        long menu,
        long item) {
    char name[8];
    long i;

    write_slot(name, menu, item);
    buf[0] = 'm';
    buf[1] = 'e';
    buf[2] = 'n';
    buf[3] = 'u';
    buf[4] = '.';
    i = 0;
    while (name[i] != 0) {
        buf[5 + i] = name[i];
        i = i + 1;
    }
    buf[5 + i] = 0;
}

static void bar_activate(
        void *action,
        void *parameter,
        void *data) {
    BarPick *pick;

    (void)action;
    (void)parameter;
    pick = (BarPick *)data;
    if (pick == nullptr || pick->action == nullptr)
        return;
    pick->action(pick->data, pick->label);
}

static void bar_state(void *action, void *value, void *data) {
    BarPick *pick;
    MenuSlot *slot;
    int on;

    pick = (BarPick *)data;
    if (pick == nullptr || pick->bar == nullptr)
        return;
    on = 0;
    if (value != nullptr && g_variant_get_boolean(value) != 0)
        on = 1;
    pick->on = on;
    slot = pick->bar->slots[pick->menu];
    if (slot != nullptr && pick->item >= 0 && pick->item < 64) {
        if (on == 0)
            slot->checkOn[pick->item] = 1;
        else
            slot->checkOn[pick->item] = 2;
    }
    if (action != nullptr && value != nullptr)
        g_simple_action_set_state(action, value);
    if (pick->action != nullptr)
        pick->action(pick->data, pick->label);
}

static void clear_slot(MenuBar *bar, long index) {
    MenuSlot *slot;
    long i;

    slot = bar->slots[index];
    if (slot == nullptr)
        return;
    i = 0;
    while (i < slot->count) {
        char name[8];

        write_slot(name, index, i);
        g_action_map_remove_action(bar->group, name);
        if (slot->labels != nullptr
                && slot->labels[i] != nullptr)
            free((void *)slot->labels[i]);
        i = i + 1;
    }
    if (slot->submenu != nullptr)
        g_menu_remove_all(slot->submenu);
    slot->labels = nullptr;
    slot->picks = nullptr;
    slot->count = 0;
}

static void fill_slot(
        MenuBar *bar,
        long index,
        const char **labels,
        long count) {
    MenuSlot *slot;
    long i;
    void (*typed)(void *, void *, void *);

    slot = bar->slots[index];
    clear_slot(bar, index);
    if (count == 0)
        return;
    slot->labels = new char *[count];
    slot->picks = new void *[count];
    slot->count = count;
    typed = bar_activate;
    i = 0;
    while (i < count) {
        BarPick *pick;
        char name[8];
        char detailed[24];
        char shown[192];
        void *simple;
        void *item;
        unsigned long id;
        const char *signal;
        int flagged;

        gtk_check_text(labels[i]);
        slot->labels[i] = gtk_copy(labels[i]);
        pick = new BarPick();
        pick->action = slot->action;
        pick->data = slot->data;
        pick->label = slot->labels[i];
        pick->bar = bar;
        pick->menu = index;
        pick->item = i;
        slot->picks[i] = (void *)pick;
        write_slot(name, index, i);
        write_bar_detailed(detailed, index, i);
        flagged = 0;
        if (i < 64)
            flagged = slot->checkOn[i];
        signal = "activate";
        if (flagged != 0) {
            void *state;
            int on;
            void (*stateFn)(void *, void *, void *);

            on = 0;
            if (flagged == 2)
                on = 1;
            pick->on = on;
            state = g_variant_new_boolean(on);
            simple = g_simple_action_new_stateful(
                    name,
                    nullptr,
                    state);
            signal = "change-state";
            stateFn = bar_state;
            typed = stateFn;
        } else {
            simple = g_simple_action_new(name, nullptr);
            typed = bar_activate;
        }
        if (simple == nullptr)
            gtk_fail("gtk");
        id = g_signal_connect_data(
                simple,
                signal,
                (void *)typed,
                (void *)pick,
                nullptr,
                0);
        if (id == 0)
            gtk_fail("gtk");
        g_action_map_add_action(bar->group, simple);
        g_object_unref(simple);
        show_mnemonic(shown, 192, labels[i]);
        item = g_menu_item_new(shown, detailed);
        if (item == nullptr)
            gtk_fail("gtk");
        if (i < 64
                && slot->accelText[i] != nullptr
                && slot->accelText[i][0] != 0) {
            void *accelValue;

            accelValue = g_variant_new_string(
                    slot->accelText[i]);
            g_menu_item_set_attribute_value(
                    item,
                    "accel",
                    accelValue);
        }
        g_menu_append_item(slot->submenu, item);
        g_object_unref(item);
        i = i + 1;
    }
}

static void refill_slot(MenuBar *bar, long index) {
    MenuSlot *slot;
    const char *saved[64];
    long n;
    long i;

    slot = bar->slots[index];
    n = slot->count;
    if (n < 0)
        n = 0;
    if (n > 64)
        n = 64;
    i = 0;
    while (i < n) {
        saved[i] = slot->labels[i];
        slot->labels[i] = nullptr;
        i = i + 1;
    }
    fill_slot(bar, index, saved, n);
    i = 0;
    while (i < n) {
        if (saved[i] != nullptr)
            free((void *)saved[i]);
        i = i + 1;
    }
}

static void bar_cleanup(Widget *widget) {
    MenuBar *bar;

    bar = (MenuBar *)widget;
    if (bar->model != nullptr) {
        g_object_unref(bar->model);
        bar->model = nullptr;
    }
    if (bar->group != nullptr) {
        g_object_unref(bar->group);
        bar->group = nullptr;
    }
}

MenuBar::MenuBar() : Widget() {
    long i;
    void (*fn)(Widget *);

    model = g_menu_new();
    group = g_simple_action_group_new();
    if (model == nullptr || group == nullptr)
        gtk_fail("gtk");
    native = gtk_sink(
            gtk_popover_menu_bar_new_from_model(model));
    gtk_widget_insert_action_group(native, "menu", group);
    menuCount = 0;
    i = 0;
    while (i < 8) {
        slots[i] = nullptr;
        i = i + 1;
    }
    fn = bar_cleanup;
    cleanup = fn;
}

long MenuBar::add_menu(
        const char *title,
        const char **labels,
        long count,
        void (*action)(void *, const char *),
        void *data) {
    MenuSlot *slot;
    long index;
    char shown[192];

    gtk_use((Widget *)this);
    gtk_check_text(title);
    if (action == nullptr)
        gtk_fail("null");
    if (menuCount >= 8)
        gtk_fail("range");
    if (count < 0 || count > 64)
        gtk_fail("range");
    if (count > 0 && labels == nullptr)
        gtk_fail("null");
    index = menuCount;
    slot = new MenuSlot();
    slot->submenu = g_menu_new();
    if (slot->submenu == nullptr)
        gtk_fail("gtk");
    slot->action = action;
    slot->data = data;
    slot->labels = nullptr;
    slot->picks = nullptr;
    slot->count = 0;
    slots[index] = slot;
    menuCount = index + 1;
    show_mnemonic(shown, 192, title);
    g_menu_append_submenu(model, shown, slot->submenu);
    fill_slot(this, index, labels, count);
    return index;
}

void MenuBar::set_menu(
        long index,
        const char **labels,
        long count) {
    gtk_use((Widget *)this);
    if (index < 0 || index >= menuCount)
        gtk_fail("range");
    if (count < 0 || count > 64)
        gtk_fail("range");
    if (count > 0 && labels == nullptr)
        gtk_fail("null");
    fill_slot(this, index, labels, count);
}

void MenuBar::set_shortcut(
        long index,
        long item,
        const char *accel) {
    MenuSlot *slot;

    gtk_use((Widget *)this);
    if (index < 0 || index >= menuCount)
        gtk_fail("range");
    if (item < 0 || item >= 64)
        gtk_fail("range");
    slot = slots[index];
    if (slot->accelText[item] != nullptr)
        free((void *)slot->accelText[item]);
    slot->accelText[item] = nullptr;
    if (accel != nullptr && accel[0] != 0) {
        gtk_check_text(accel);
        slot->accelText[item] = gtk_copy(accel);
    }
    if (item < slot->count)
        refill_slot(this, index);
}

void MenuBar::set_check(long index, long item, int on) {
    MenuSlot *slot;

    gtk_use((Widget *)this);
    if (index < 0 || index >= menuCount)
        gtk_fail("range");
    slot = slots[index];
    if (item < 0 || item >= slot->count)
        gtk_fail("range");
    if (on == 0)
        slot->checkOn[item] = 1;
    else
        slot->checkOn[item] = 2;
    refill_slot(this, index);
}

int MenuBar::is_checked(long index, long item) {
    MenuSlot *slot;

    gtk_use((Widget *)this);
    if (index < 0 || index >= menuCount)
        return 0;
    slot = slots[index];
    if (slot == nullptr || item < 0 || item >= 64)
        return 0;
    if (slot->checkOn[item] == 2)
        return 1;
    return 0;
}

Popover::Popover() : Widget() {
    kind = GTK_KIND_POPOVER;
    native = gtk_sink(gtk_popover_new());
}

void Popover::set_child(Widget *child) {
    gtk_check_child((Widget *)this, child);
    gtk_require_single((Widget *)this);
    gtk_popover_set_child(native, child->native);
    gtk_note_child((Widget *)this, child);
}

void Popover::popup() {
    gtk_use((Widget *)this);
    gtk_popover_popup(native);
}

void Popover::popdown() {
    gtk_use((Widget *)this);
    gtk_popover_popdown(native);
}

Paned::Paned(int orientation) : Widget() {
    if (orientation != GTK_HORIZONTAL
            && orientation != GTK_VERTICAL)
        gtk_fail("range");
    orient = orientation;
    kind = GTK_KIND_PANED;
    native = gtk_sink(gtk_paned_new(orientation));
    startChild = nullptr;
    endChild = nullptr;
}

int Paned::orientation() const {
    gtk_use((Widget *)this);
    return orient;
}

void Paned::set_start_child(Widget *child) {
    gtk_use((Widget *)this);
    if (child == nullptr)
        gtk_fail("null");
    if (startChild == child)
        return;
    if (startChild != nullptr) {
        gtk_note_remove((Widget *)this, startChild);
        startChild = nullptr;
    }
    gtk_check_child((Widget *)this, child);
    gtk_paned_set_start_child(native, child->native);
    gtk_note_child((Widget *)this, child);
    startChild = child;
}

void Paned::set_end_child(Widget *child) {
    gtk_use((Widget *)this);
    if (child == nullptr)
        gtk_fail("null");
    if (endChild == child)
        return;
    if (endChild != nullptr) {
        gtk_note_remove((Widget *)this, endChild);
        endChild = nullptr;
    }
    gtk_check_child((Widget *)this, child);
    gtk_paned_set_end_child(native, child->native);
    gtk_note_child((Widget *)this, child);
    endChild = child;
}

void Paned::set_position(long position) {
    gtk_use((Widget *)this);
    gtk_paned_set_position(native, gtk_int(position));
}

long Paned::position() const {
    gtk_use((Widget *)this);
    return gtk_paned_get_position(native);
}

Notebook::Notebook() : Widget() {
    kind = GTK_KIND_NOTEBOOK;
    native = gtk_sink(gtk_notebook_new());
}

long Notebook::append_page(
        Widget *child,
        const char *title) {
    void *tab;
    int index;

    gtk_check_child((Widget *)this, child);
    gtk_check_text(title);
    tab = gtk_label_new(title);
    index = gtk_notebook_append_page(
            native,
            child->native,
            tab);
    if (index < 0)
        gtk_fail("gtk");
    gtk_note_child((Widget *)this, child);
    return index;
}

void Notebook::set_tab_label(
        long index,
        const char *title) {
    void *page;

    gtk_use((Widget *)this);
    gtk_check_text(title);
    if (index < 0 || index >= childCount)
        gtk_fail("range");
    page = gtk_notebook_get_nth_page(
            native,
            gtk_int(index));
    if (page == nullptr)
        gtk_fail("range");
    gtk_notebook_set_tab_label_text(native, page, title);
}

void Notebook::set_tab(long index, Widget *tab) {
    void *page;

    gtk_use((Widget *)this);
    if (tab == nullptr)
        gtk_fail("null");
    if (index < 0 || index >= childCount)
        gtk_fail("range");
    page = gtk_notebook_get_nth_page(
            native,
            gtk_int(index));
    if (page == nullptr)
        gtk_fail("range");
    gtk_notebook_set_tab_label(native, page, tab->native);
}

void Notebook::remove_page(long index) {
    Widget *child;

    gtk_use((Widget *)this);
    if (index < 0 || index >= childCount)
        gtk_fail("range");
    child = children[index];
    gtk_notebook_remove_page(native, gtk_int(index));
    gtk_note_remove((Widget *)this, child);
}

long Notebook::current_page() const {
    gtk_use((Widget *)this);
    return gtk_notebook_get_current_page(native);
}

void Notebook::set_current_page(long index) {
    gtk_use((Widget *)this);
    if (index < 0 || index >= childCount)
        gtk_fail("range");
    gtk_notebook_set_current_page(
            native,
            gtk_int(index));
}

SignalConnection Notebook::on_switch_page(
        void (*action)(void *, long),
        void *data) {
    SignalConnection *slot;
    void (*typed)(void *, void *, unsigned, void *);
    void *handler;
    void (*user)(void *, long);
    void *userAction;

    gtk_use((Widget *)this);
    if (action == nullptr)
        gtk_fail("null");
    typed = notebook_switch;
    handler = (void *)typed;
    user = action;
    userAction = (void *)user;
    slot = gtk_bind(
            native,
            "switch-page",
            handler,
            userAction,
            data,
            0);
    gtk_keep((Widget *)this, slot);
    return *slot;
}

ColumnView::ColumnView() : Widget() {
    void *list;
    void *selection;

    list = gtk_string_list_new(nullptr);
    if (list == nullptr)
        gtk_fail("gtk");
    selection = gtk_no_selection_new(list);
    if (selection == nullptr)
        gtk_fail("gtk");
    native = gtk_sink(gtk_column_view_new(selection));
    cells = nullptr;
    rowCount = 0;
    rowRoom = 0;
    columnCount = 0;
    rows = list;
    columnData = nullptr;
}

void ColumnView::append_column(const char *title) {
    ColumnSlot *slot;
    void *factory;
    void *column;
    void *slotPtr;
    void (*setup)(void *, void *, void *);
    void (*bind)(void *, void *, void *);
    void *handler;
    void **grown;
    long i;
    unsigned long id;

    gtk_use((Widget *)this);
    gtk_check_text(title);
    i = 0;
    while (i < rowCount) {
        char **widened;
        long j;

        char **old;

        widened = new char *[columnCount + 1];
        old = (char **)cells[i];
        j = 0;
        while (j < columnCount) {
            widened[j] = old[j];
            j = j + 1;
        }
        widened[columnCount] = gtk_copy("");
        cells[i] = widened;
        i = i + 1;
    }
    slot = new ColumnSlot();
    slot->view = this;
    slot->column = columnCount;
    grown = new void *[columnCount + 1];
    i = 0;
    while (i < columnCount) {
        grown[i] = columnData[i];
        i = i + 1;
    }
    grown[columnCount] = slot;
    columnData = grown;
    factory = gtk_signal_list_item_factory_new();
    if (factory == nullptr)
        gtk_fail("gtk");
    setup = column_setup;
    handler = (void *)setup;
    slotPtr = (void *)slot;
    id = g_signal_connect_data(
            factory,
            "setup",
            handler,
            slotPtr,
            nullptr,
            0);
    if (id == 0)
        gtk_fail("gtk");
    bind = column_bind;
    handler = (void *)bind;
    id = g_signal_connect_data(
            factory,
            "bind",
            handler,
            slotPtr,
            nullptr,
            0);
    if (id == 0)
        gtk_fail("gtk");
    column = gtk_column_view_column_new(title, factory);
    if (column == nullptr)
        gtk_fail("gtk");
    gtk_column_view_append_column(native, column);
    g_object_unref(column);
    columnCount = columnCount + 1;
}

void ColumnView::append_row(
        const char **cells,
        long count) {
    char **row;
    void **grown;
    long next;
    long i;

    gtk_use((Widget *)this);
    if (count != columnCount)
        gtk_fail("range");
    if (count > 0 && cells == nullptr)
        gtk_fail("null");
    row = new char *[count];
    i = 0;
    while (i < count) {
        gtk_check_text(cells[i]);
        row[i] = gtk_copy(cells[i]);
        i = i + 1;
    }
    if (rowCount >= rowRoom) {
        next = rowRoom * 2;
        if (next < 4)
            next = 4;
        grown = new void *[next];
        i = 0;
        while (i < next) {
            grown[i] = nullptr;
            i = i + 1;
        }
        i = 0;
        while (i < rowCount) {
            grown[i] = this->cells[i];
            i = i + 1;
        }
        rowRoom = next;
        this->cells = grown;
    }
    this->cells[rowCount] = row;
    rowCount = rowCount + 1;
    gtk_string_list_append((void *)rows, "");
}

void ColumnView::clear_rows() {
    long row;
    long column;

    gtk_use((Widget *)this);
    row = 0;
    while (row < rowCount) {
        char **line;

        line = (char **)cells[row];
        column = 0;
        while (column < columnCount) {
            if (line[column] != nullptr)
                free((void *)line[column]);
            column = column + 1;
        }
        row = row + 1;
    }
    while (rowCount > 0) {
        rowCount = rowCount - 1;
        gtk_string_list_remove(
                (void *)rows,
                (unsigned)rowCount);
    }
    cells = nullptr;
    rowRoom = 0;
}

long ColumnView::row_count() const {
    gtk_use((Widget *)this);
    return rowCount;
}

long ColumnView::column_count() const {
    gtk_use((Widget *)this);
    return columnCount;
}

const char *ColumnView::cell(
        long row,
        long column) const {
    char **line;

    gtk_use((Widget *)this);
    if (row < 0 || row >= rowCount)
        gtk_fail("range");
    if (column < 0 || column >= columnCount)
        gtk_fail("range");
    line = (char **)cells[row];
    return gtk_text_or_empty(line[column]);
}

SignalConnection ColumnView::on_activate(
        void (*action)(void *, long),
        void *data) {
    SignalConnection *slot;
    void (*typed)(void *, unsigned, void *);
    void *handler;
    void (*user)(void *, long);
    void *userAction;

    gtk_use((Widget *)this);
    if (action == nullptr)
        gtk_fail("null");
    typed = column_activate;
    handler = (void *)typed;
    user = action;
    userAction = (void *)user;
    slot = gtk_bind(
            native,
            "activate",
            handler,
            userAction,
            data,
            0);
    gtk_keep((Widget *)this, slot);
    return *slot;
}

}
