int flag;

int side(void) {
    flag = 7;
    return 1;
}

int main(void) {
    int andN;
    int orN;
    int andFlag;
    int orFlag;

    flag = 0;
    if (0 && side()) {
        andN = 1;
    } else {
        andN = 0;
    }
    andFlag = flag;
    flag = 0;
    if (1 || side()) {
        orN = 1;
    } else {
        orN = 0;
    }
    orFlag = flag;
    print("lang-short-circuit {} {} {} {}\n",
        andN,
        andFlag,
        orN,
        orFlag);
    return 0;
}
