#include <select>
#include <unistd>

int main(void) {
    int fds[2];
    fd_set readfds;
    struct timespec limit;
    char byte;
    int n;
    int ok;

    ok = 0;
    byte = 0;
    if (pipe(fds) == 0) {
        FD_ZERO(&readfds);
        FD_SET(fds[0], &readfds);
        if (write(fds[1], (void *)"x", 1) == 1) {
            limit.tv_sec = 1;
            limit.tv_nsec = 0;
            n = pselect(fds[0] + 1, &readfds,
                nullptr, nullptr, &limit, nullptr);
            if (n == 1 && FD_ISSET(fds[0], &readfds) != 0
                    && read(fds[0], (void *)&byte, 1) == 1
                    && byte == 'x')
                ok = 1;
        }
        close(fds[0]);
        close(fds[1]);
    }
    print("rt-pselect {}\n", ok);
    return 0;
}
