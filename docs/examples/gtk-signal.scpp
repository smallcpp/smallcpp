#include <exceptions>
#include <gtk>

using namespace Gtk;

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


void clicked(void *data) {
    (void)data;
}

int main(void) {
    Button *button;
    SignalConnection *fresh;
    SignalConnection slot;
    int ok;

    try {
        fresh = new SignalConnection();
        fresh->disconnect();
        button = new Button("Go");
        slot = button->on_clicked(clicked, nullptr);
        ok = 0;
        if (fresh->connected() == false && slot.connected()) {
            slot.disconnect();
            if (slot.connected() == false)
                ok = 1;
        }
        print("gtk-signal {}\n", ok);
        return 0;
    } catch (Exception error) {
        if (same(error.message, "display")) {
            print("SKIP gtk display\n");
            return 77;
        }
        return 1;
    }
}
