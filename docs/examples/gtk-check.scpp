#include <exceptions>
#include <gtk>

using namespace Gtk;

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


void toggled(void *data, bool active) {
    (void)data;
    (void)active;
}

int main(void) {
    CheckButton *check;
    SignalConnection slot;
    int ok;

    try {
        check = new CheckButton("No");
        check->set_label("Yes");
        slot = check->on_toggled(toggled, nullptr);
        check->set_active(true);
        ok = 0;
        if (same(check->label(), "Yes")
                && check->active()
                && slot.connected())
            ok = 1;
        print("gtk-check {}\n", ok);
        return 0;
    } catch (Exception error) {
        if (same(error.message, "display")) {
            print("SKIP gtk display\n");
            return 77;
        }
        return 1;
    }
}
