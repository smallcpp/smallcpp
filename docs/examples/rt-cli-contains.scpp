#include <cli>

using namespace Cli;

int starts(const char *text, const char *prefix) {
    long i;

    i = 0;
    while (prefix[i] != 0) {
        if (text == nullptr || text[i] != prefix[i])
            return 0;
        i = i + 1;
    }
    return 1;
}

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


int main(void) {
    CommandLine *command;
    Option *include;
    char *args[3];
    int ok;

    command = new CommandLine("demo", "contains", "1");
    include = new Option();
    include->short_name = "I";
    include->name = "include";
    include->value_type = CLI_STRING;
    include->is_list = true;
    command->add_option(include);
    args[0] = "demo";
    args[1] = "-IFOO:BAR";
    command->parse(2, args);
    ok = 0;
    if (command->contains_item("include", "BAR"))
        ok = 1;
    print("rt-cli-contains {}\n", ok);
    return 0;
}
