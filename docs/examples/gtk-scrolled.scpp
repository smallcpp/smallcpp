#include <exceptions>
#include <gtk>

using namespace Gtk;

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


int main(void) {
    ScrolledWindow *frame;
    Label *child;
    int ok;

    try {
        frame = new ScrolledWindow();
        frame->set_policy(
            GTK_POLICY_AUTOMATIC,
            GTK_POLICY_NEVER);
        child = new Label("Hi");
        frame->set_child((Widget *)child);
        frame->remove((Widget *)child);
        ok = 1;
        print("gtk-scrolled {}\n", ok);
        return 0;
    } catch (Exception error) {
        if (same(error.message, "display")) {
            print("SKIP gtk display\n");
            return 77;
        }
        return 1;
    }
}
