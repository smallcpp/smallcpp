#include <stdarg>

int read_one(int n, ...) {
    va_list args;
    va_list copy;
    int first;
    int fromCopy;

    va_start(args, n);
    va_copy(copy, args);
    first = va_arg(args, int);
    fromCopy = va_arg(copy, int);
    va_end(args);
    va_end(copy);
    if (first == 10 && fromCopy == 10)
        return 1;
    return 0;
}

int main(void) {
    print("rt-stdarg {}\n", read_one(1, 10));
    return 0;
}
