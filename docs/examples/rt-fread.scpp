#include <stdio>
#include <stdlib>
#include <unistd>


void copy_text(char *buf, const char *text) {
    long i;

    i = 0;
    while (text[i] != 0) {
        buf[i] = text[i];
        i = i + 1;
    }
    buf[i] = 0;
}

void join_path(char *buf, const char *dir, const char *name) {
    long i;
    long n;

    i = 0;
    while (dir[i] != 0) {
        buf[i] = dir[i];
        i = i + 1;
    }
    buf[i] = '/';
    i = i + 1;
    n = 0;
    while (name[n] != 0) {
        buf[i] = name[n];
        i = i + 1;
        n = n + 1;
    }
    buf[i] = 0;
}

void zero(void *ptr, long n) {
    char *bytes;
    long i;

    bytes = (char *)ptr;
    i = 0;
    while (i < n) {
        bytes[i] = 0;
        i = i + 1;
    }
}

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


int main(void) {
    char pattern[40];
    char data[8];
    File *stream;
    int fd;
    int ok;
    unsigned long count;

    ok = 0;
    copy_text(pattern, "/tmp/scpp-fread-XXXXXX");
    fd = mkstemp(pattern);
    if (fd >= 0) {
        if (write(fd, (void *)"abcd", 4) == 4 && close(fd) == 0) {
            stream = fopen(pattern, "rb");
            count = 0;
            if (stream != nullptr)
                count = fread((void *)data, 1, 4, stream);
            if (stream != nullptr)
                fclose(stream);
            if (count == 4 && data[0] == 'a')
                ok = 1;
        }
        remove(pattern);
    }
    print("rt-fread {}\n", ok);
    return 0;
}
