#include <exceptions>
#include <gtk>

using namespace Gtk;

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


void answered(void *data, int response) {
    (void)data;
    (void)response;
}

int main(void) {
    Dialog *dialog;
    Label *body;
    SignalConnection slot;
    int ok;

    try {
        dialog = new Dialog("Ask");
        dialog->set_title("Hello");
        body = new Label("Body");
        dialog->set_content((Widget *)body);
        dialog->add_button("Close", 1);
        slot = dialog->on_response(answered, nullptr);
        dialog->present();
        ok = 0;
        if (same(dialog->title(), "Hello") && slot.connected())
            ok = 1;
        print("gtk-dialog {}\n", ok);
        return 0;
    } catch (Exception error) {
        if (same(error.message, "display")) {
            print("SKIP gtk display\n");
            return 77;
        }
        return 1;
    }
}
