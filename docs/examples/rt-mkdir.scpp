#include <stat>
#include <stdlib>
#include <unistd>


void copy_text(char *buf, const char *text) {
    long i;

    i = 0;
    while (text[i] != 0) {
        buf[i] = text[i];
        i = i + 1;
    }
    buf[i] = 0;
}

void join_path(char *buf, const char *dir, const char *name) {
    long i;
    long n;

    i = 0;
    while (dir[i] != 0) {
        buf[i] = dir[i];
        i = i + 1;
    }
    buf[i] = '/';
    i = i + 1;
    n = 0;
    while (name[n] != 0) {
        buf[i] = name[n];
        i = i + 1;
        n = n + 1;
    }
    buf[i] = 0;
}

void zero(void *ptr, long n) {
    char *bytes;
    long i;

    bytes = (char *)ptr;
    i = 0;
    while (i < n) {
        bytes[i] = 0;
        i = i + 1;
    }
}

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


int main(void) {
    char pattern[40];
    char path[64];
    char *dir;
    int ok;

    ok = 0;
    copy_text(pattern, "/tmp/scpp-mkdir-XXXXXX");
    dir = mkdtemp(pattern);
    if (dir != nullptr) {
        join_path(path, dir, "sub");
        if (mkdir(path, 448) == 0 && rmdir(path) == 0)
            ok = 1;
        rmdir(dir);
    }
    print("rt-mkdir {}\n", ok);
    return 0;
}
