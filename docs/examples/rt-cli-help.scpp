#include <cli>

using namespace Cli;

int starts(const char *text, const char *prefix) {
    long i;

    i = 0;
    while (prefix[i] != 0) {
        if (text == nullptr || text[i] != prefix[i])
            return 0;
        i = i + 1;
    }
    return 1;
}

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


int main(void) {
    CommandLine *command;
    int ok;

    command = new CommandLine("demo", "show help", "1");
    ok = 0;
    if (starts(command->help_text(), "Usage: demo"))
        ok = 1;
    print("rt-cli-help {}\n", ok);
    return 0;
}
