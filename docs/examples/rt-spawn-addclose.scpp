#include <spawn>
#include <unistd>


void copy_text(char *buf, const char *text) {
    long i;

    i = 0;
    while (text[i] != 0) {
        buf[i] = text[i];
        i = i + 1;
    }
    buf[i] = 0;
}

void join_path(char *buf, const char *dir, const char *name) {
    long i;
    long n;

    i = 0;
    while (dir[i] != 0) {
        buf[i] = dir[i];
        i = i + 1;
    }
    buf[i] = '/';
    i = i + 1;
    n = 0;
    while (name[n] != 0) {
        buf[i] = name[n];
        i = i + 1;
        n = n + 1;
    }
    buf[i] = 0;
}

void zero(void *ptr, long n) {
    char *bytes;
    long i;

    bytes = (char *)ptr;
    i = 0;
    while (i < n) {
        bytes[i] = 0;
        i = i + 1;
    }
}

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


int main(void) {
    posix_spawn_file_actions_t actions;
    int fds[2];
    int ok;

    ok = 0;
    if (pipe(fds) != 0)
        return 1;
    if (posix_spawn_file_actions_init(&actions) == 0
            && posix_spawn_file_actions_addclose(
                &actions, fds[0]) == 0
            && posix_spawn_file_actions_destroy(&actions) == 0)
        ok = 1;
    close(fds[0]);
    close(fds[1]);
    print("rt-spawn-addclose {}\n", ok);
    return 0;
}
