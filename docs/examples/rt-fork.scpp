#include <spawn>
#include <stdlib>
#include <unistd>

int main(void) {
    pid_t pid;
    int status;
    int ok;

    ok = 0;
    pid = fork();
    if (pid == 0)
        exit(0);
    status = 0;
    if (pid > 0 && waitpid(pid, &status, 0) == pid
            && WIFEXITED(status) != 0
            && WEXITSTATUS(status) == 0)
        ok = 1;
    print("rt-fork {}\n", ok);
    return 0;
}
