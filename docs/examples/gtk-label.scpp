#include <exceptions>
#include <gtk>

using namespace Gtk;

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


int main(void) {
    Label *label;
    int ok;

    try {
        label = new Label("Hi");
        label->set_text("Hello");
        ok = 0;
        if (same(label->text(), "Hello"))
            ok = 1;
        print("gtk-label {}\n", ok);
        return 0;
    } catch (Exception error) {
        if (same(error.message, "display")) {
            print("SKIP gtk display\n");
            return 77;
        }
        return 1;
    }
}
