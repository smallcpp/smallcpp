#include <exceptions>
#include <gtk>

using namespace Gtk;

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


int main(void) {
    Label *label;
    int ok;

    try {
        label = new Label("Hi");
        label->set_visible(true);
        label->set_sensitive(false);
        label->set_h_expand(true);
        label->set_v_expand(false);
        label->set_width_request(40);
        label->add_css_class("note");
        label->remove_css_class("note");
        label->set_tooltip("tip");
        ok = 0;
        if (label->disposed() == false) {
            label->dispose();
            if (label->disposed())
                ok = 1;
        }
        print("gtk-widget {}\n", ok);
        return 0;
    } catch (Exception error) {
        if (same(error.message, "display")) {
            print("SKIP gtk display\n");
            return 77;
        }
        return 1;
    }
}
