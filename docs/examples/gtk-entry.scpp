#include <exceptions>
#include <gtk>

using namespace Gtk;

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


int edits;

void changed(void *data) {
    int *flag;

    flag = (int *)data;
    *flag = *flag + 1;
}

int main(void) {
    Entry *entry;
    int ok;

    try {
        entry = new Entry("");
        edits = 0;
        entry->on_changed(changed, (void *)&edits);
        entry->set_text("hi");
        ok = 0;
        if (same(entry->text(), "hi") && edits == 1)
            ok = 1;
        print("gtk-entry {}\n", ok);
        return 0;
    } catch (Exception error) {
        if (same(error.message, "display")) {
            print("SKIP gtk display\n");
            return 77;
        }
        return 1;
    }
}
