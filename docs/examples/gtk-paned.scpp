#include <exceptions>
#include <gtk>

using namespace Gtk;

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


int main(void) {
    Paned *pane;
    Label *start;
    Label *end;
    int ok;

    try {
        pane = new Paned(GTK_HORIZONTAL);
        start = new Label("L");
        end = new Label("R");
        pane->set_start_child((Widget *)start);
        pane->set_end_child((Widget *)end);
        pane->set_position(40);
        ok = 0;
        if (pane->orientation() == GTK_HORIZONTAL
                && pane->position() == 40)
            ok = 1;
        print("gtk-paned {}\n", ok);
        return 0;
    } catch (Exception error) {
        if (same(error.message, "display")) {
            print("SKIP gtk display\n");
            return 77;
        }
        return 1;
    }
}
