#include <cli>

using namespace Cli;

int starts(const char *text, const char *prefix) {
    long i;

    i = 0;
    while (prefix[i] != 0) {
        if (text == nullptr || text[i] != prefix[i])
            return 0;
        i = i + 1;
    }
    return 1;
}

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


int main(void) {
    CommandLine *command;
    Positional *input;
    char *args[4];
    int ok;

    command = new CommandLine("demo", "position at", "1");
    input = new Positional();
    input->name = "input";
    input->is_list = true;
    command->add_positional(input);
    args[0] = "demo";
    args[1] = "a.scpp";
    args[2] = "b.scpp";
    command->parse(3, args);
    ok = 0;
    if (same(command->positional_at(1), "b.scpp"))
        ok = 1;
    print("rt-cli-positional-at {}\n", ok);
    return 0;
}
