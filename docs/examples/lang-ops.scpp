int main(void) {
    int a;
    int b;
    int ok;

    a = 6;
    b = 4;
    ok = 1;
    if (a + b != 10 || a - b != 2 || a * b != 24)
        ok = 0;
    if (a / b != 1 || a % b != 2)
        ok = 0;
    if ((a << 1) != 12 || (a >> 1) != 3)
        ok = 0;
    if ((a & b) != 4 || (a | b) != 6 || (a ^ b) != 2)
        ok = 0;
    if ((~0 & 1) != 1 || -a != -6 || !0 != 1)
        ok = 0;
    if ((1 && 0) != 0 || (0 || 1) != 1)
        ok = 0;
    print("lang-ops {}\n", ok);
    return 0;
}
