#include <fcntl>
#include <stdlib>
#include <unistd>


void copy_text(char *buf, const char *text) {
    long i;

    i = 0;
    while (text[i] != 0) {
        buf[i] = text[i];
        i = i + 1;
    }
    buf[i] = 0;
}

void join_path(char *buf, const char *dir, const char *name) {
    long i;
    long n;

    i = 0;
    while (dir[i] != 0) {
        buf[i] = dir[i];
        i = i + 1;
    }
    buf[i] = '/';
    i = i + 1;
    n = 0;
    while (name[n] != 0) {
        buf[i] = name[n];
        i = i + 1;
        n = n + 1;
    }
    buf[i] = 0;
}

void zero(void *ptr, long n) {
    char *bytes;
    long i;

    bytes = (char *)ptr;
    i = 0;
    while (i < n) {
        bytes[i] = 0;
        i = i + 1;
    }
}

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


int main(void) {
    char leftPat[40];
    char rightPat[40];
    int inFd;
    int outFd;
    int ok;
    long count;

    ok = 0;
    copy_text(leftPat, "/tmp/scpp-cfr-a-XXXXXX");
    copy_text(rightPat, "/tmp/scpp-cfr-b-XXXXXX");
    inFd = mkstemp(leftPat);
    outFd = mkstemp(rightPat);
    if (inFd >= 0 && outFd >= 0
            && write(inFd, (void *)"abcd", 4) == 4
            && lseek(inFd, 0, 0) == 0) {
        count = copy_file_range(
            inFd, nullptr, outFd, nullptr, 4, 0);
        if (count == 4)
            ok = 1;
    }
    if (inFd >= 0)
        close(inFd);
    if (outFd >= 0)
        close(outFd);
    unlink(leftPat);
    unlink(rightPat);
    print("rt-copy-file-range {}\n", ok);
    return 0;
}
