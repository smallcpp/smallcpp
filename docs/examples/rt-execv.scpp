#include <spawn>
#include <stdlib>
#include <unistd>

void copy_text(char *buf, const char *text) {
    long i;

    i = 0;
    while (text[i] != 0) {
        buf[i] = text[i];
        i = i + 1;
    }
    buf[i] = 0;
}

int main(void) {
    char arg0[8];
    char *args[2];
    pid_t pid;
    int status;
    int ok;

    copy_text(arg0, "true");
    args[0] = arg0;
    args[1] = nullptr;
    ok = 0;
    pid = fork();
    if (pid == 0) {
        execv("/bin/true", args);
        exit(1);
    }
    status = 0;
    if (pid > 0 && waitpid(pid, &status, 0) == pid
            && WIFEXITED(status) != 0
            && WEXITSTATUS(status) == 0)
        ok = 1;
    print("rt-execv {}\n", ok);
    return 0;
}
