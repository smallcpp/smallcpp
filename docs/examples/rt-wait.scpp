#include <spawn>
#include <stdlib>
#include <unistd>

int main(void) {
    pid_t pid;
    pid_t got;
    int status;
    int ok;

    ok = 0;
    pid = fork();
    if (pid == 0)
        exit(0);
    status = 0;
    got = -1;
    if (pid > 0)
        got = wait(&status);
    if (got == pid && WIFEXITED(status) != 0
            && WEXITSTATUS(status) == 0)
        ok = 1;
    print("rt-wait {}\n", ok);
    return 0;
}
