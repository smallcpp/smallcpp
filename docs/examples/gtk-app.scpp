#include <exceptions>
#include <gtk>

using namespace Gtk;

int same(const char *left, const char *right) {
    long i;

    if (left == nullptr || right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && left[i] == right[i])
        i = i + 1;
    if (left[i] == right[i])
        return 1;
    return 0;
}


void started(void *data) {
    (void)data;
}

void later(void *data) {
    (void)data;
}

int main(void) {
    Application *app;
    SignalConnection slot;
    int posted;
    int ok;

    try {
        app = new Application("com.smallcpp.docs");
        slot = app->on_activate(started, nullptr);
        posted = 0;
        try {
            app->post(later, nullptr);
        } catch (Exception error) {
            if (same(error.message, "post"))
                posted = 1;
        }
        ok = 0;
        if (slot.connected()
                && app->cancel(99) == false
                && posted == 1)
            ok = 1;
        print("gtk-app {}\n", ok);
        return 0;
    } catch (Exception error) {
        if (same(error.message, "display")) {
            print("SKIP gtk display\n");
            return 77;
        }
        return 1;
    }
}
