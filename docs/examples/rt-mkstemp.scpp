#include <stdlib>
#include <unistd>


void copy_text(char *buf, const char *text) {
    long i;

    i = 0;
    while (text[i] != 0) {
        buf[i] = text[i];
        i = i + 1;
    }
    buf[i] = 0;
}

int main(void) {
    char pattern[40];
    int fd;
    int ok;

    ok = 0;
    copy_text(pattern, "/tmp/scpp-mkstemp-XXXXXX");
    fd = mkstemp(pattern);
    if (fd >= 0 && close(fd) == 0 && unlink(pattern) == 0)
        ok = 1;
    print("rt-mkstemp {}\n", ok);
    return 0;
}
